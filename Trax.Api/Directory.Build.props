<Project>
  <PropertyGroup>
    <Version>1.99.99</Version>
    <Authors>Theauxm</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TraxSharp/Trax.Api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://traxsharp.net/docs</PackageProjectUrl>
    <PackageTags>trax;dotnet;graphql;hotchocolate;api</PackageTags>
    <!-- Audit direct + transitive dependencies and fail the build on any known
         vulnerability (low through critical). -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Every project restores with a lockfile. Without this, a locked-mode restore checks a
       lockfile only where one happens to be committed, and a new project without one restores
       unlocked and passes CI. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Package validation: `dotnet pack` compares each published library with the last release on
       nuget.org and fails on a binary break, such as removing or narrowing a public member a
       consumer compiled against. It runs on pack only, so the pull request workflow packs too.
       Bump the baseline to the new version after each release. The Version above (1.99.99
       locally, the released version in CI) is the package being checked, not the baseline.
       Every project under src/ ships as a package; the test projects do not. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\','/').Contains('/src/'))">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.44.1</PackageValidationBaselineVersion>
    <!-- The XML doc file ships in the package so IntelliSense (and anyone reading the package
         without the source) gets the /// summaries. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every package carries a README. A project replaces the file packed as README.md by
         setting TraxPackageReadme; the auth and audit packages do, to lead with the disclaimer. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TraxPackageReadme>$(MSBuildThisFileDirectory)README.md</TraxPackageReadme>
    <!-- No .snupkg: DotNet.ReproducibleBuilds embeds the PDB, SourceLink included, in each DLL. -->
  </PropertyGroup>

  <!-- Item conditions are evaluated after every property, so a TraxPackageReadme set in the
       project file is the one packed here. -->
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\','/').Contains('/src/'))">
    <None Include="$(TraxPackageReadme)" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <!-- Deterministic/reproducible builds. CI source-path normalization
       (ContinuousIntegrationBuild) is turned on by the package only when CI is detected. -->
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All" />
  </ItemGroup>
</Project>
