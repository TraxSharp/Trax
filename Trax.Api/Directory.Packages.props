<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Let a central PackageVersion pin a transitively-referenced package
         (used to force a patched SQLite native lib below). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Local development override. When trax-local.props exists (created by the
    workspace pack-local.sh), it sets TraxLocalVersion=1.99.99 so the locally
    packed Trax.* packages win over the CI-pinned versions below. The file is
    git-ignored and absent in CI, where the exact pins are used.
  -->
  <Import Project="trax-local.props" Condition="Exists('trax-local.props')" />

  <!-- Trax cross-repo packages. CI pins below; overridable via TraxLocalVersion. -->
  <ItemGroup>
    <PackageVersion Include="Trax.Core.Testing" Version="1.7.0" />
    <PackageVersion Include="Trax.Effect" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Data" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Data.InMemory" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Data.Postgres" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Data.Sqlite" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Provider.Json" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Provider.Parameter" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.StateMachine" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.StateMachine.Persistence" Version="1.54.0" />
    <PackageVersion Include="Trax.Mediator" Version="1.22.0" />
    <PackageVersion Include="Trax.Scheduler" Version="1.32.0" />
  </ItemGroup>

  <!-- Third-party packages, pinned to exact resolved versions. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="GraphQL" Version="8.8.4" />
    <PackageVersion Include="GraphQL.Client" Version="6.1.0" />
    <PackageVersion Include="GraphQL.Client.Serializer.SystemTextJson" Version="6.1.0" />
    <PackageVersion Include="HotChocolate" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.AspNetCore.Authorization" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.CostAnalysis" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.Data" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.Data.EntityFramework" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.Execution.Projections" Version="16.6.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.9" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.12"
    />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
    <!-- Transitive (via EF Core Sqlite): pull the patched native SQLite lib (CVE-2025-6965). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <!--
    Local development override. pack-local.sh writes a gitignored trax-local.props
    setting TraxLocalVersion=1.99.99; this redirects every Trax.* pin above to the
    locally packed build. The pins themselves stay plain literal versions so they
    stay machine-readable: an MSBuild expression in the Version attribute is not a
    version Dependabot can parse, and it silently skipped every one of them.
  -->
  <ItemGroup Condition="'$(TraxLocalVersion)' != ''">
    <PackageVersion Update="Trax.Core.Testing" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.InMemory" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.Postgres" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.Sqlite" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Provider.Json" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Provider.Parameter" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.StateMachine" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.StateMachine.Persistence" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Mediator" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Scheduler" Version="$(TraxLocalVersion)" />
  </ItemGroup>
</Project>
