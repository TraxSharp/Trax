<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <AssemblyName>Trax.Api.Dashboard</AssemblyName>
    <RootNamespace>Trax.Api.Dashboard</RootNamespace>
    <PackageDescription>The Trax .NET operations dashboard as a single-page app your Trax.Api host serves: runs, the work queue, dead letters, manifests, logs, trains, effects and state machines, read and changed through the host's Trax GraphQL operations surface. The built app ships inside the package, so the host needs no Node. Map it with app.UseTraxApiDashboard().</PackageDescription>
    <PackageTags>trax;dotnet;graphql;dashboard;react;operations</PackageTags>
    <TraxPackageReadme>$(MSBuildThisFileDirectory)README.md</TraxPackageReadme>
    <!-- Not yet released, so there is no baseline to validate against. Remove after its first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <!-- The React app's source is its own npm project; nothing in it is an item of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Api.GraphQL/Trax.Api.GraphQL.csproj" />
  </ItemGroup>

  <!-- The app (ClientApp/, Vite and React) is built with node and embedded in this assembly, from
       where UseTraxApiDashboard() serves it (DashboardAssets). A build compiles and embeds it when
       ClientApp has its npm packages installed, and otherwise builds without it, so a plain
       `dotnet build` needs no node; mapping a build without it fails at startup, naming the fix.
       Packing refuses an assembly without it, so a package always carries the app. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);VerifyTraxDashboardAppIsEmbedded</TargetsForTfmSpecificContentInPackage>
    <TraxDashboardAppDir>$(MSBuildThisFileDirectory)ClientApp/</TraxDashboardAppDir>
    <TraxDashboardAppInstalled
      Condition="Exists('$(TraxDashboardAppDir)node_modules/vite/package.json')"
      >true</TraxDashboardAppInstalled>
  </PropertyGroup>

  <ItemGroup Condition="'$(TraxDashboardAppInstalled)' == 'true'">
    <TraxDashboardAppInput Include="$(TraxDashboardAppDir)src/**/*" />
    <TraxDashboardAppInput Include="$(TraxDashboardAppDir)public/**/*" />
    <TraxDashboardAppInput Include="$(TraxDashboardAppDir)index.html;$(TraxDashboardAppDir)package-lock.json;$(TraxDashboardAppDir)vite.config.ts;$(TraxDashboardAppDir)tsconfig*.json;$(TraxDashboardAppDir)scripts/check-bundle.mjs" />
  </ItemGroup>

  <!-- The list of the app's source files, rewritten only when the list changes. It is an input of
       the build below, so deleting or renaming a file rebuilds the app: a deleted file leaves no
       newer input behind, and without the list vite would be skipped and the old app embedded. -->
  <Target Name="ListTraxDashboardAppInputs" Condition="'$(TraxDashboardAppInstalled)' == 'true'">
    <PropertyGroup>
      <_TraxDashboardAppInputList>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)trax-dashboard-app.inputs</_TraxDashboardAppInputList>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_TraxDashboardAppInputList)"
      Lines="@(TraxDashboardAppInput->'%(FullPath)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
  </Target>

  <Target
    Name="BuildTraxDashboardApp"
    Condition="'$(TraxDashboardAppInstalled)' == 'true'"
    DependsOnTargets="ListTraxDashboardAppInputs"
    Inputs="@(TraxDashboardAppInput);$(_TraxDashboardAppInputList)"
    Outputs="$(TraxDashboardAppDir)dist/index.html"
  >
    <Exec
      Command="node --version"
      ContinueOnError="true"
      IgnoreExitCode="true"
      StandardOutputImportance="low"
      EchoOff="true"
    >
      <Output TaskParameter="ExitCode" PropertyName="_TraxNodeExitCode" />
    </Exec>
    <Error
      Condition="'$(_TraxNodeExitCode)' != '0'"
      Text="Building Trax.Api.Dashboard compiles its React app with node, because $(TraxDashboardAppDir) has its npm packages installed, and node is not on PATH. Install Node.js 22 or later, or delete that node_modules folder to build without the app."
    />
    <!-- tsc typechecks it, vite builds it into dist/, and check-bundle refuses a build that carries
         the mock or the demo, or that the host's Content-Security-Policy would refuse. -->
    <Exec
      Command="npm run build"
      WorkingDirectory="$(TraxDashboardAppDir)"
      StandardOutputImportance="low"
    />
  </Target>

  <Target
    Name="EmbedTraxDashboardApp"
    BeforeTargets="PrepareResourceNames"
    DependsOnTargets="BuildTraxDashboardApp"
    Condition="'$(TraxDashboardAppInstalled)' == 'true'"
  >
    <ItemGroup>
      <_TraxDashboardAppFile Include="$(TraxDashboardAppDir)dist/**/*" />
      <EmbeddedResource
        Include="@(_TraxDashboardAppFile)"
        LogicalName="TraxApiDashboard/$([MSBuild]::MakeRelative('$(TraxDashboardAppDir)dist/', '%(_TraxDashboardAppFile.FullPath)').Replace('\', '/'))"
        WithCulture="false"
        Type="Non-Resx"
      />
    </ItemGroup>
  </Target>

  <!-- Records, after each compile, what the assembly it compiled carries of the app, for the pack
       check below: the names of the embedded TraxApiDashboard/* files, and the files the embedded
       index.html names (its relative src and href URLs). After the compile rather than with the
       items above, because a pack with no-build can run the resource targets without compiling
       anything. -->
  <Target Name="RecordTraxDashboardAppEmbedded" AfterTargets="CoreCompile">
    <PropertyGroup>
      <_TraxDashboardAppMarker>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)trax-dashboard-app.embedded</_TraxDashboardAppMarker>
      <_TraxDashboardAppReferences>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)trax-dashboard-app.references</_TraxDashboardAppReferences>
      <_TraxDashboardAppIndex>$(TraxDashboardAppDir)dist/index.html</_TraxDashboardAppIndex>
      <!-- Every relative src or href in the page, as "a;b;", and a ";" for every other character:
           empty items, which MSBuild drops once the list is unescaped into items below. -->
      <_TraxDashboardAppReferenceList
        Condition="'$(TraxDashboardAppInstalled)' == 'true' And Exists('$(_TraxDashboardAppIndex)')"
        >$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(_TraxDashboardAppIndex)')), '(?s)\b(?:src|href)="(?:\./)?(?![a-zA-Z][a-zA-Z0-9+.-]*:|/|#)([^"?#]+)[^"]*"|.', '$1;'))</_TraxDashboardAppReferenceList>
    </PropertyGroup>
    <ItemGroup Condition="'$(TraxDashboardAppInstalled)' == 'true'">
      <_TraxDashboardAppEmbeddedName
        Include="@(EmbeddedResource->'%(LogicalName)')"
        Condition="$([System.String]::Copy('%(EmbeddedResource.LogicalName)').StartsWith('TraxApiDashboard/'))"
      />
      <_TraxDashboardAppReference Include="$([MSBuild]::Unescape($(_TraxDashboardAppReferenceList)))" />
    </ItemGroup>
    <WriteLinesToFile
      Condition="'$(TraxDashboardAppInstalled)' == 'true'"
      File="$(_TraxDashboardAppMarker)"
      Lines="@(_TraxDashboardAppEmbeddedName)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
    <WriteLinesToFile
      Condition="'$(TraxDashboardAppInstalled)' == 'true'"
      File="$(_TraxDashboardAppReferences)"
      Lines="@(_TraxDashboardAppReference->'TraxApiDashboard/%(Identity)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
    <Delete
      Condition="'$(TraxDashboardAppInstalled)' != 'true'"
      Files="$(_TraxDashboardAppMarker);$(_TraxDashboardAppReferences)"
    />
  </Target>

  <!-- Refuses to pack an assembly that does not carry a working app: index.html and every file it
       names must be among the embedded resources, so a build whose dist/ came out empty or partial
       fails here rather than in a host. -->
  <Target Name="VerifyTraxDashboardAppIsEmbedded">
    <PropertyGroup>
      <_TraxDashboardAppMarker>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)trax-dashboard-app.embedded</_TraxDashboardAppMarker>
      <_TraxDashboardAppReferences>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)trax-dashboard-app.references</_TraxDashboardAppReferences>
    </PropertyGroup>
    <Error
      Condition="'$(TraxDashboardAppInstalled)' != 'true'"
      Text="Packing Trax.Api.Dashboard needs its React app built into it, with node, and $(TraxDashboardAppDir) has no node_modules. Run `npm ci --ignore-scripts` there, then build and pack again."
    />
    <Error
      Condition="!Exists('$(_TraxDashboardAppMarker)') Or !Exists('$(_TraxDashboardAppReferences)')"
      Text="Packing Trax.Api.Dashboard needs its React app built into it, and the last build of this project ran before $(TraxDashboardAppDir) had its npm packages. Build it again, then pack."
    />
    <ReadLinesFromFile File="$(_TraxDashboardAppMarker)">
      <Output TaskParameter="Lines" ItemName="_TraxDashboardAppEmbeddedLine" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_TraxDashboardAppReferences)">
      <Output TaskParameter="Lines" ItemName="_TraxDashboardAppReferenceLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_TraxDashboardAppIndexLine
        Include="@(_TraxDashboardAppEmbeddedLine)"
        Condition="'%(Identity)' == 'TraxApiDashboard/index.html'"
      />
      <_TraxDashboardAppMissing
        Include="@(_TraxDashboardAppReferenceLine)"
        Exclude="@(_TraxDashboardAppEmbeddedLine)"
      />
    </ItemGroup>
    <Error
      Condition="'@(_TraxDashboardAppIndexLine)' == ''"
      Text="Packing Trax.Api.Dashboard needs its React app built into it, and the last build embedded no TraxApiDashboard/index.html: $(TraxDashboardAppDir)dist/ was empty or incomplete. Run `npm run build` there, then build and pack again."
    />
    <Error
      Condition="'@(_TraxDashboardAppReferenceLine)' == ''"
      Text="Packing Trax.Api.Dashboard needs its React app built into it, and the embedded index.html names no script or stylesheet, so it is not the app's build. Run `npm run build` in $(TraxDashboardAppDir), then build and pack again."
    />
    <Error
      Condition="'@(_TraxDashboardAppMissing)' != ''"
      Text="Packing Trax.Api.Dashboard needs its React app built into it, and the embedded index.html names files the last build did not embed: @(_TraxDashboardAppMissing, ', '). Run `npm run build` in $(TraxDashboardAppDir), then build and pack again."
    />
  </Target>
</Project>
