<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <AssemblyName>Trax.Api.GraphQL.PersistedOperations</AssemblyName>
    <PackageDescription>Persisted GraphQL operations for Trax: server-managed manifest mapping build-time-stable operation IDs to documents. Lets shipped clients (mobile, etc.) hot-fix server-side queries without redeploying the client. Includes shape-diff guardrail, optional in-memory cache, and optional RabbitMQ-backed multi-node cache invalidation.</PackageDescription>
    <PackageTags>trax;graphql;persisted-operations;hotchocolate</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Api.GraphQL/Trax.Api.GraphQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>
</Project>
