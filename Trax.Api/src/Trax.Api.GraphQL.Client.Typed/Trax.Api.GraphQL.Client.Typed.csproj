<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <AssemblyName>Trax.Api.GraphQL.Client.Typed</AssemblyName>
    <RootNamespace>Trax.Api.GraphQL.Client.Typed</RootNamespace>
    <PackageDescription>POCO-derived GraphQL queries for Trax.Api.GraphQL.Client. The POCO IS the selection set; the library generates the query string at startup against the active schema.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Api.GraphQL.Client/Trax.Api.GraphQL.Client.csproj" />
  </ItemGroup>
</Project>
