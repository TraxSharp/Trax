<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <AssemblyName>Trax.Api.GraphQL.Client.Trax</AssemblyName>
    <RootNamespace>Trax.Api.GraphQL.Client.Trax</RootNamespace>
    <PackageDescription>Trax integration layer for Trax.Api.GraphQL.Client: AssemblySchemaProvider, GraphQLQueryJunction, log correlation, dashboard discovery.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Api.Tests" />
    <InternalsVisibleTo Include="Trax.Api.GraphQL.Client.Typed" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Api.GraphQL.Client/Trax.Api.GraphQL.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate" Version="15.*" />
    <PackageReference Include="HotChocolate.Execution" Version="15.*" />
    <PackageReference Include="Trax.Effect" Version="1.*" />
    <PackageReference Include="Trax.Mediator" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.*" />
  </ItemGroup>
</Project>
