<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <AssemblyName>Trax.Api</AssemblyName>
    <PackageDescription>Core services behind the Trax .NET GraphQL API: health checks, per-train authorization, the HTTP principal provider and the shared DTOs. Trax.Api.GraphQL brings it in; reference it directly only to use those services without the GraphQL schema.</PackageDescription>
    <!-- TRAXEXP003: the run graph says where a failed run can resume from its checkpoints and
         which nodes a resumed run restored. -->
    <NoWarn>$(NoWarn);TRAXEXP003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Trax.Effect/src/Trax.Effect/Trax.Effect.csproj" />
    <ProjectReference Include="../../../Trax.Effect/src/Trax.Effect.Data/Trax.Effect.Data.csproj" />
    <ProjectReference Include="../../../Trax.Mediator/src/Trax.Mediator/Trax.Mediator.csproj" />
    <ProjectReference Include="../../../Trax.Scheduler/src/Trax.Scheduler/Trax.Scheduler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes the ProcessCpuSampler test seam (internal ctor + ComputePercent) for deterministic
         unit tests without widening the public API. -->
    <InternalsVisibleTo Include="Trax.Api.Tests" />
    <!-- The GraphQL subscriptions number lifecycle events through TrainLifecycleEvent.PublishSequence. -->
    <InternalsVisibleTo Include="Trax.Api.GraphQL" />
  </ItemGroup>
</Project>
