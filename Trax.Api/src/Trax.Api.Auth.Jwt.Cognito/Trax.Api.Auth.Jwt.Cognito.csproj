<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <AssemblyName>Trax.Api.Auth.Jwt.Cognito</AssemblyName>
    <PackageDescription>Amazon Cognito helpers for Trax JWT auth: claim normalization (cognito:groups, identities[], identity_provider) and a builder extension that wires both ID-token and access-token validation against a Cognito user pool. NO WARRANTY. Trax auth is plumbing, not a security product. You are solely responsible for securing systems that use it. See SECURITY-DISCLAIMER.md.</PackageDescription>
    <PackageReleaseNotes>NO WARRANTY. Trax auth is plumbing, not a security product. You are solely responsible for securing systems that use it. See SECURITY-DISCLAIMER.md.</PackageReleaseNotes>
    <PackageTags>trax;auth;jwt;cognito;aws;security</PackageTags>
    <!-- The package README leads with the security disclaimer, then shows usage. -->
    <TraxPackageReadme>$(MSBuildThisFileDirectory)..\AUTH-PACKAGE-README.md</TraxPackageReadme>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Api.Auth.Jwt/Trax.Api.Auth.Jwt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\SECURITY-DISCLAIMER.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
