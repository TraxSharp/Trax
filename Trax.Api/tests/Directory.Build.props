<Project>
  <!-- MSBuild reads only the nearest Directory.Build.props, so this one imports the folder's own first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- [Red] runs a test written before its code with an inverted verdict, so it runs in CI without
       failing the build until the code arrives. Every test project of this folder compiles the one copy. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile
      Include="$(MSBuildThisFileDirectory)RedAttribute.cs"
      Link="RedAttribute.cs"
      Visible="false"
    />
    <Using Include="Trax.Testing.Red" />
    <!-- Null.Of<T>(): a null passed on purpose, where the null-forgiving operator is banned. A
         project that passes one compiles it (TraxTestsNull), so no other carries an unused type. -->
    <Compile
      Condition="'$(TraxTestsNull)' == 'true'"
      Include="$(MSBuildThisFileDirectory)Null.cs"
      Link="Null.cs"
      Visible="false"
    />
    <Using Include="Trax.Testing" />
  </ItemGroup>
</Project>
