<Project>
  <!-- Every package version in this repository is pinned here; the project files carry none.
       Transitive pinning applies a pin below to a package that arrives only transitively too. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

  <!--
    The packages a compiled snippet in tests/Trax.Docs.Snippets.Tests is checked against: the
    published releases on nuget.org, pinned exactly, never main and never the workspace's local
    1.99.99 build. A fence marked `csharp compile` sees exactly these assemblies, so a page can only
    show an API a reader can install today. Bumping a pin re-checks every compiled snippet against
    the new release, and DocsPackageVersionsTests then asks for the versions shown on the pages to
    move with it.
  -->
  <ItemGroup Label="Trax">
    <PackageVersion Include="Trax.Api" Version="1.46.0" />
    <PackageVersion Include="Trax.Api.Auth.ApiKey" Version="1.46.0" />
    <PackageVersion Include="Trax.Api.GraphQL" Version="1.46.0" />
    <PackageVersion Include="Trax.Core" Version="1.9.1" />
    <PackageVersion Include="Trax.Dashboard" Version="1.18.0" />
    <PackageVersion Include="Trax.Effect" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.Data.InMemory" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.Data.Postgres" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.JunctionProvider.Logging" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.JunctionProvider.Progress" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.Provider.Json" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.Provider.Parameter" Version="1.59.0" />
    <PackageVersion Include="Trax.Mediator" Version="1.24.1" />
    <PackageVersion Include="Trax.Scheduler" Version="1.36.1" />
  </ItemGroup>
</Project>
