            "trigger": "CloseGate"
          },
          {
            "from": "Open",
            "to": "Closed",
            "trigger": "CloseGate"
          },
          {
            "from": "Open",
            "to": "Open",
            "trigger": "OpenCheckIn"
          },
          {
            "from": "Scheduled",
            "to": "Open",
            "trigger": "OpenCheckIn"
          }
