          "Closed": {
            "fields": []
          },
          "Departed": {
            "fields": []
          },
          "Open": {
            "fields": []
          },
          "Scheduled": {
            "fields": []
          }
        },
        "id": "flight",
        "initialContext": {},
        "initialState": "Scheduled",
        "inputs": {},
        "states": [
          "Closed",
          "Departed",
          "Open",
          "Scheduled"
        ],
        "timers": [
