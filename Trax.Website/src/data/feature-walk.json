          "reads": [
            {
              "machine": "booking"
            }
          ],
          "fields": {
            "status": {
              "from": "booking.state",
              "labels": {
                "Booked": "Booked",
                "Open": "Open for check-in",
                "Issuing": "Getting a boarding pass",
                "CheckedIn": "Checked in",
                "TurnedDown": "Passport not accepted",
                "NotIssued": "No boarding pass yet",
                "Missed": "Missed the flight"
              }
            },
            "seat": {
              "from": "booking.seat"
            }
          }
        },
        "departures": {
          "reads": [
            {
              "machine": "flight",
              "key": "flight/tx101"
            }
          ],
          "fields": {
            "status": {
              "from": "flight.state",
              "labels": {
                "Scheduled": "Scheduled",
                "Open": "Check-in open",
                "Closed": "Gate closed",
                "Departed": "Departed"
              }
            }
          }
        }
      }
    }
  }
}
