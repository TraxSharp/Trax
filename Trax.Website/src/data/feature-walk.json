                  "value": {
                    "input": "passport"
                  }
                }
              ]
            },
            "to": "Open",
            "trigger": "GivePassport"
          },
          {
            "from": "Open",
            "to": "Missed",
            "trigger": "Miss"
          }
        ],
        "triggers": [
          "CheckIn",
          "GivePassport",
          "Miss",
          "OpenCheckIn"
        ],
        "version": 1
      }
    },
    "flight": {
      "file": "machines/flight.ir.json",
