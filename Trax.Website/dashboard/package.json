{
  "name": "trax-api-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs dist app",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "bash scripts/e2e.sh",
    "e2e:seed": "docker exec -i trax_stress_db psql -U trax -d trax_dashboard_e2e < scripts/e2e-seed.sql",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "mock:schema": "node scripts/export-schema.mjs",
    "mock:capture": "tsx scripts/capture-fixtures.ts",
    "mock:smoke": "tsx scripts/mock-client-smoke.ts",
    "mock:smoke:overlays": "tsx scripts/mock-overlays-smoke.ts",
    "build:demo": "tsc -b && vite build --mode demo && node scripts/check-bundle.mjs dist-demo demo"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@urql/core": "^6.0.1",
    "graphql": "^16.13.2",
    "graphql-ws": "^6.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@graphql-tools/mock": "^9.1.14",
    "@graphql-tools/schema": "^10.0.35",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@urql/exchange-execute": "^3.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.10"
  }
}
