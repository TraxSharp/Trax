{
  "openapi": "3.0.1",
  "info": {
    "title": "Converging inputs",
    "version": "1.0"
  },
  "paths": {
    "/items/{update_value}": {
      "post": {
        "operationId": "updateItem",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "name": "update_value",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updateValue",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Updated"
          }
        }
      }
    },
    "/players/{id}": {
      "put": {
        "operationId": "replacePlayer",
        "tags": [
          "Players"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Player"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Replaced"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Player": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
