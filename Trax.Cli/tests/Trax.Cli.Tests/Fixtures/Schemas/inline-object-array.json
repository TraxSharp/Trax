{
  "openapi": "3.0.3",
  "info": {
    "title": "Inline Object Array API",
    "version": "1.0.0"
  },
  "paths": {
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List events",
        "tags": ["Events"],
        "responses": {
          "200": {
            "description": "List of events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "title": { "type": "string" },
                      "start_date": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/speakers": {
      "get": {
        "operationId": "listSpeakers",
        "summary": "List speakers",
        "tags": ["Events"],
        "responses": {
          "200": {
            "description": "List of speakers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Speaker" }
                }
              }
            }
          }
        }
      }
    },
    "/raw": {
      "get": {
        "operationId": "getRawData",
        "summary": "Get raw data",
        "tags": ["Data"],
        "responses": {
          "200": {
            "description": "Raw data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "object" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Speaker": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "bio": { "type": "string" }
        }
      }
    }
  }
}
