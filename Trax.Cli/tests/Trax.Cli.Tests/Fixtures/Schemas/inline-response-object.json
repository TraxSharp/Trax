{
  "openapi": "3.0.0",
  "info": { "title": "Inline Response Object", "version": "1.0" },
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["count"],
                  "properties": {
                    "count": {
                      "type": "integer",
                      "description": "Total widget count"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/empty": {
      "get": {
        "operationId": "noContent",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/non-json": {
      "get": {
        "operationId": "binaryDownload",
        "responses": {
          "200": {
            "description": "Binary",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      }
    }
  }
}
