{{- if ModelsUsing }}
using {{ ModelsUsing }};
{{- end }}

namespace {{ Namespace }};

public record {{ TypeName }}
{
{{- for field in Fields }}
  {{- if field.Description }}
    /// <summary>
    /// {{ field.Description }}
    /// </summary>
  {{- end }}
    public {{ field.RequiredKeyword }}{{ field.TypeName }}{{ field.NullableMarker }} {{ field.SanitizedName }} { get; init; }
{{- end }}
}
