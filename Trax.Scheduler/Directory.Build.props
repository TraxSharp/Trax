<Project>
  <PropertyGroup>
    <Version>1.99.99</Version>
    <!-- Audit direct + transitive dependencies and fail the build on any known
         vulnerability (low through critical). -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Every project restores with a lockfile. Without this, a locked-mode restore checks a
       lockfile only where one happens to be committed, and a new project without one restores
       unlocked and passes CI. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Package validation: `dotnet pack` compares each published library with the last release on
       nuget.org and fails on a binary break, such as removing or narrowing a member a separately
       shipped package (the Lambda runner, a consumer's worker) was built against. It runs on pack
       only, so the pull request workflow packs too. Bump the baseline to the new version after
       each release. The Version above (1.99.99 locally, the released version in CI) is the package
       being checked, not the baseline.
       The four published packages are listed by name, and a new package must be added here. Nothing
       under tests/ is packed. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Trax.Scheduler' Or '$(MSBuildProjectName)' == 'Trax.Scheduler.Lambda' Or '$(MSBuildProjectName)' == 'Trax.Scheduler.Sqs' Or '$(MSBuildProjectName)' == 'Trax.Runner.Lambda'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.34.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- NuGet metadata shared by every package this repo publishes. A project may override any of
       these; each sets its own Description. No .snupkg: DotNet.ReproducibleBuilds embeds the PDB,
       with its SourceLink map, in each DLL, so a symbol package would be empty. -->
  <PropertyGroup>
    <Authors>Theauxm</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TraxSharp/Trax</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://traxsharp.net/docs</PackageProjectUrl>
    <PackageTags>trax;dotnet;scheduler;cron;jobs;background-jobs;work-queue;dead-letter</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The published libraries (the same four as package validation above) ship their XML doc
       comments, so the API is documented from the installed package alone. Every public member is
       documented, and CS1591 (a public member with no doc comment) stays on to keep it that way. -->
  <PropertyGroup Condition="'$(EnablePackageValidation)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="\"
      Visible="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All" />
  </ItemGroup>
</Project>
