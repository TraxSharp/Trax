<Project Sdk="Microsoft.NET.Sdk">
  <!-- The launcher as a process, the one-line Program.cs a deploy writes, for the cluster escape suite
       (KubernetesEscapeTests). Never packed or shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Trax.Scheduler.Sandbox.LauncherHost</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Trax.Scheduler.Sandbox.Launcher/Trax.Scheduler.Sandbox.Launcher.csproj" />
  </ItemGroup>
</Project>
