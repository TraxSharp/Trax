<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Trax.Scheduler.Tests.ArrayLogger</AssemblyName>
    <Description>Test helper for Trax.Scheduler: an in-memory ILoggerProvider that captures every log entry in lists so tests can assert on what a train or the scheduler logged. Reference it from test projects only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Trax.Effect" />
  </ItemGroup>
</Project>
