<Project Sdk="Microsoft.NET.Sdk">
  <!-- The image the sandbox escape tests run: a Trax sandbox entry point and one train that,
       depending on its input, behaves or tries to get out. Built into an image by
       build-escape-image.sh; never packed or shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Trax.Scheduler.Sandbox.Image</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Trax.Scheduler/Trax.Scheduler.csproj" />
    <ProjectReference Include="../../../Trax.Effect/src/Trax.Effect.Data.InMemory/Trax.Effect.Data.InMemory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
