<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Trax.Scheduler</AssemblyName>
    <Description>Recurring and one-off scheduling for Trax .NET trains: cron and interval manifests, a durable work queue, retries, dead-lettering and dependent trains. Requires a persistent Trax data provider such as Trax.Effect.Data.Postgres.</Description>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- TRAXEXP002: the dispatcher carries the state-machine instance that invoked a run to its
         metadata, and the operations service refuses to requeue such a run. -->
    <NoWarn>$(NoWarn);TRAXEXP002</NoWarn>
    <!-- TRAXEXP003: the dispatcher carries the run a queued run resumes to its metadata, and retries
         and the operator's resume queue resumed runs. -->
    <NoWarn>$(NoWarn);TRAXEXP003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Trax.Effect/src/Trax.Effect/Trax.Effect.csproj" />
    <ProjectReference Include="../../../Trax.Mediator/src/Trax.Mediator/Trax.Mediator.csproj" />
    <ProjectReference Include="../../../Trax.Effect/src/Trax.Effect.Data/Trax.Effect.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Cronos" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Scheduler.Tests" />
    <InternalsVisibleTo Include="Trax.Scheduler.Tests.Integration" />
    <InternalsVisibleTo Include="Trax.Scheduler.Tests.Stress" />
    <InternalsVisibleTo Include="Trax.Scheduler.Tests.Sqlite.Integration" />
    <InternalsVisibleTo Include="Trax.Runner.Lambda" />
  </ItemGroup>
</Project>
