<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Let a central PackageVersion apply to a package that also arrives
         transitively, so one version wins across the graph. It does NOT mean a
         PackageVersion can stand alone: one with no PackageReference anywhere is
         invisible to Dependabot and freezes. See the Tests.Meta pin guard. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Local dev override: when present, trax-local.props sets TraxLocalVersion (e.g. 1.99.99)
       so the local NuGet feed wins. CI leaves it absent and the exact pins below apply. -->
  <Import
    Project="$(MSBuildThisFileDirectory)trax-local.props"
    Condition="Exists('$(MSBuildThisFileDirectory)trax-local.props')"
  />

  <ItemGroup Label="Trax">
    <PackageVersion Include="Trax.Effect" Version="1.54.2" />
    <PackageVersion Include="Trax.Effect.Data" Version="1.54.2" />
    <PackageVersion Include="Trax.Effect.Data.InMemory" Version="1.54.2" />
    <PackageVersion Include="Trax.Effect.Data.Postgres" Version="1.54.2" />
    <PackageVersion Include="Trax.Effect.Data.Sqlite" Version="1.54.2" />
    <PackageVersion Include="Trax.Effect.JunctionProvider.Logging" Version="1.54.2" />
    <PackageVersion Include="Trax.Effect.JunctionProvider.Progress" Version="1.54.2" />
    <PackageVersion Include="Trax.Effect.Provider.Json" Version="1.54.2" />
    <PackageVersion Include="Trax.Effect.Provider.Parameter" Version="1.54.2" />
    <PackageVersion Include="Trax.Mediator" Version="1.22.1" />
  </ItemGroup>

  <ItemGroup Label="AWS">
    <PackageVersion Include="AWSSDK.Lambda" Version="4.0.104" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.4" />
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.1.1" />
    <PackageVersion Include="Amazon.Lambda.SQSEvents" Version="3.0.0" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.0" />
    <PackageVersion Include="Amazon.Lambda.TestUtilities" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
  </ItemGroup>

  <ItemGroup Label="Testing and tooling">
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <!-- Referenced directly by the SQLite-using project(s) below rather than pinned
         transitively: a PackageVersion with no PackageReference is invisible to
         Dependabot and freezes, which for a CVE floor means it silently stops
         working. Overrides the vulnerable native lib EF Core Sqlite pulls
         transitively (CVE-2025-6965). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!--
    Local development override. pack-local.sh writes a gitignored trax-local.props
    setting TraxLocalVersion=1.99.99; this redirects every Trax.* pin above to the
    locally packed build. The pins themselves stay plain literal versions so they
    stay machine-readable: an MSBuild expression in the Version attribute is not a
    version Dependabot can parse, and it silently skipped every one of them.
  -->
  <ItemGroup Condition="'$(TraxLocalVersion)' != ''">
    <PackageVersion Update="Trax.Effect" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.InMemory" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.Postgres" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.Sqlite" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.JunctionProvider.Logging" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.JunctionProvider.Progress" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Provider.Json" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Provider.Parameter" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Mediator" Version="$(TraxLocalVersion)" />
  </ItemGroup>
</Project>
