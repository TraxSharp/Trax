{
  "id": "turnstile",
  "version": 1,
  "initialState": "Locked",
  "states": ["Locked", "Unlocked"],
  "triggers": ["Coin", "Push"],
  "committedStates": [],
  "context": {
    "Locked": { "fields": [] },
    "Unlocked": {
      "fields": [
        {
          "name": "paidWith",
          "type": "string",
          "nullable": false,
          "constraints": [
            { "rule": "nonEmpty", "source": "context", "field": "paidWith" }
          ]
        }
      ]
    }
  },
  "inputs": {
    "Coin": {
      "fields": [{ "name": "coin", "type": "string", "nullable": false, "constraints": [] }]
    }
  },
  "transitions": [
    {
      "from": "Locked",
      "trigger": "Coin",
      "to": "Unlocked",
      "guard": {
        "rule": "oneOf",
        "source": "input",
        "field": "coin",
        "values": ["quarter", "dollar"]
      },
      "guardMessage": "Only a quarter or a dollar is accepted.",
      "reduce": {
        "reduce": "set",
        "steps": [{ "field": "paidWith", "value": { "input": "coin" } }]
      }
    },
    {
      "from": "Unlocked",
      "trigger": "Push",
      "to": "Locked",
      "reduce": { "reduce": "clear" }
    }
  ]
}
