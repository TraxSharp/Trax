{
  "name": "Locked + Coin(dollar) transitions to Unlocked and records paidWith",
  "given": { "machine": "turnstile", "version": 1, "state": "Locked", "context": {} },
  "when": { "trigger": "Coin", "input": { "coin": "dollar" } },
  "expect": {
    "outcome": "transitioned",
    "snapshot": { "machine": "turnstile", "version": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } }
  }
}
