# Rules of the Trax.Analyzers profile that this repository turns off, everywhere. Written by hand:
# each line carries its reason on the line above, as "# Exempt:" (keeping the rule would break a
# published promise) or "# Deferred:" (the work is owed and tracked). AnalyzerProfileTests in
# Trax.Core.Tests.Meta refuses a line without one, a rule rules.txt does not list, and any other
# file that switches a rule off. The profile itself is Trax.Analyzers/rules.txt.
is_global = true

# Exempt: Either<TLeft, TRight>.Left and .Right are public static factories on a generic type.
dotnet_diagnostic.TRX0018.severity = none

# Exempt: Train.Junctions() is documented to throw NotImplementedException until it is overridden.
dotnet_diagnostic.TRX0025.severity = none

# Exempt: renaming a public type named like its namespace (Trax.Core.Monad.Monad and others) is a
# binary break.
dotnet_diagnostic.TRX0049.severity = none

# Exempt: the rule (deprecated upstream in favour of CA1822) asks for public instance members that
# use no state to become static, which breaks every caller (IrMachine.Serialize and others).
dotnet_diagnostic.TRX0038.severity = none

# Exempt: the property form of TRX0038, for the same reason.
dotnet_diagnostic.TRX0041.severity = none
