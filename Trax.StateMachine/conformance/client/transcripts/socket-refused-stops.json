{
  "about": "A socket the host closes with 4403 before it is acknowledged stops the client for good as FORBIDDEN: a later send is answered stopped without reaching the host, and nothing is subscribed again.",
  "machine": "turnstile",
  "instance": "i-1",
  "refuseConnections": 1,
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "stopped", "error": "FORBIDDEN" } },
    { "client": "send", "trigger": "Coin", "input": { "coin": "quarter" }, "expect": { "outcome": "stopped", "code": "FORBIDDEN" } },
    { "quiet": 50 }
  ]
}
