{
  "about": "A request timeout of zero or less waits for no answer, and one past 2^31 - 1 ms is one no timer waits for: the client refuses to be built with either, and builds with one from 1 ms to that.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "build", "requestTimeout": 0, "expect": { "built": false, "code": "INVALID_OPTION" } },
    { "client": "build", "requestTimeout": -5, "expect": { "built": false, "code": "INVALID_OPTION" } },
    { "client": "build", "requestTimeout": 2147483648, "expect": { "built": false, "code": "INVALID_OPTION" } },
    { "client": "build", "requestTimeout": 1000, "expect": { "built": true } },
    { "client": "build", "requestTimeout": 2147483647, "expect": { "built": true } }
  ]
}
