{
  "about": "A request whose answer never comes fails as TRANSPORT_ERROR, a value; retry resends it under the same requestId and prediction, so a host that did apply it replays it.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "variables": { "id": "i-1" }, "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "push", "variables": { "id": "i-1", "requestId": "r1", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Locked\",\"context\":{}}" }, "drop": true },
    { "await": "push", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "state": "Unlocked", "pending": false, "problem": "TRANSPORT_ERROR", "error": null } },
    { "client": "retry", "as": "retry" },
    { "request": "push", "variables": { "id": "i-1", "requestId": "r1", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Locked\",\"context\":{}}" }, "answer": { "id": "i-1", "revision": 2, "state": "Locked", "context": {} } },
    { "await": "retry", "expect": { "outcome": "confirmed", "state": "Locked", "revision": 2 } },
    { "view": { "state": "Locked", "problem": null } },
    { "client": "retry", "expect": { "outcome": "failed", "code": "NOTHING_TO_RETRY" } }
  ]
}
