{
  "about": "A socket the host closes with 4401 while subscribed (the caller's token expired) stops the client for good as UNAUTHENTICATED, and nothing is subscribed again.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "dropSocket": 4401 },
    { "view": { "status": "stopped", "error": "UNAUTHENTICATED" } },
    { "client": "send", "trigger": "Coin", "input": { "coin": "quarter" }, "expect": { "outcome": "stopped", "code": "UNAUTHENTICATED" } },
    { "quiet": 50 }
  ]
}
