{
  "about": "SERVER_OUTDATED past the last retry delay fails the event, which retry can resend.",
  "machine": "turnstile",
  "instance": "i-1",
  "retryDelays": [10],
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "push", "errors": [{ "message": "Another version answered.", "extensions": { "code": "SERVER_OUTDATED" } }] },
    { "request": "push", "errors": [{ "message": "Another version answered.", "extensions": { "code": "SERVER_OUTDATED" } }] },
    { "await": "push", "expect": { "outcome": "failed", "code": "SERVER_OUTDATED" } },
    { "client": "retry", "as": "retry" },
    { "request": "push", "variables": { "id": "i-1", "requestId": "r1", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Locked\",\"context\":{}}" }, "answer": { "id": "i-1", "revision": 2, "state": "Locked", "context": {} } },
    { "await": "retry", "expect": { "outcome": "confirmed", "revision": 2 } }
  ]
}
