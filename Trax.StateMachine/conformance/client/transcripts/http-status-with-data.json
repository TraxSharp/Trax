{
  "about": "A 500 whose body carries an answer has not been answered: TRANSPORT_ERROR.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "push", "status": 500, "body": { "data": { "machines": { "turnstile": { "push": { "id": "i-1", "revision": 2, "state": "Locked", "context": {}, "dueAt": null, "dueAtKnown": true, "problem": null } } } } } },
    { "await": "push", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "revision": 1, "problem": "TRANSPORT_ERROR" } }
  ]
}
