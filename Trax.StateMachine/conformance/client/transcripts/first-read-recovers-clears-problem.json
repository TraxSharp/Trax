{
  "about": "A first read that fails once and gets through on its own retry shows no problem: the failure it recovered from is not left on the view.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "retryDelays": [10, 10],
  "steps": [
    { "client": "start", "as": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "variables": { "id": "i-1" }, "status": 503 },
    { "request": "get", "variables": { "id": "i-1" }, "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "await": "start", "expect": { "settled": true } },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1, "problem": null } }
  ]
}
