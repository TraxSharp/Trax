{
  "about": "An answer whose state is not a string, or that holds none beside no problem, fails that send as TRANSPORT_ERROR, changes nothing, and the client carries on.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "as": "push1" },
    { "request": "push", "answer": { "id": "i-1", "revision": 2, "state": 5, "context": {}, "dueAt": null, "dueAtKnown": true, "problem": null }, "bare": true },
    { "await": "push1", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1, "pending": false, "problem": "TRANSPORT_ERROR", "error": null }, "once": true },
    { "client": "send", "trigger": "Push", "as": "push2" },
    { "request": "push", "answer": { "id": "i-1", "revision": 2, "context": {}, "dueAt": null, "dueAtKnown": true, "problem": null }, "bare": true },
    { "await": "push2", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1, "pending": false, "problem": "TRANSPORT_ERROR", "error": null }, "once": true },
    { "client": "send", "trigger": "Push", "as": "good" },
    { "request": "push", "answer": { "id": "i-1", "revision": 2, "state": "Locked", "context": {} } },
    { "await": "good", "expect": { "outcome": "confirmed", "state": "Locked", "revision": 2 } }
  ]
}
