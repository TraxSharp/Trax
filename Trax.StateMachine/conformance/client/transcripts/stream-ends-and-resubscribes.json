{
  "about": "A stream the host completes without saying why is subscribed again after the resubscribe delay, and its first event is taken as any other.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "complete": true },
    { "subscribe": { "id": "i-1" } },
    { "push": { "revision": 2, "state": "Unlocked", "context": { "paidWith": "quarter" } } },
    { "view": { "state": "Unlocked", "revision": 2, "error": null } }
  ]
}
