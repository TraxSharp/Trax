{
  "about": "A trigger the machine does not declare is refused where it is sent, as NO_TRANSITION, and nothing reaches the host: not even one whose name is an operation's own (discard, start, get), which would otherwise go out as that operation.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Discard", "expect": { "outcome": "refused", "code": "NO_TRANSITION" } },
    { "client": "send", "trigger": "Start", "expect": { "outcome": "refused", "code": "NO_TRANSITION" } },
    { "client": "send", "trigger": "Get", "expect": { "outcome": "refused", "code": "NO_TRANSITION" } },
    { "client": "send", "trigger": "Nope", "expect": { "outcome": "refused", "code": "NO_TRANSITION" } },
    { "view": { "status": "ready", "error": null } },
    { "quiet": 50 }
  ]
}
