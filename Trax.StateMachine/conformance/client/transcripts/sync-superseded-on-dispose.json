{
  "about": "A sync superseded while its event is in flight settles superseded when the client is disposed, and the one that took it over, still waiting for that event, settles failed as DISPOSED.",
  "machine": "wizard",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "begin": "$id: UUID!, $requestId: String!, $clientResult: String",
    "update": "$id: UUID!, $input: UpdateInput!, $requestId: String!, $clientResult: String",
    "next": "$id: UUID!, $requestId: String!, $clientResult: String",
    "back": "$id: UUID!, $requestId: String!, $clientResult: String",
    "skip": "$id: UUID!, $requestId: String!, $clientResult: String",
    "send": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Start", "context": {} } },
    { "view": { "status": "ready", "unsaved": false } },
    { "client": "sync", "target": "Review", "fields": { "trigger": "Update", "input": { "email": "ada@example.com", "name": "Ada" } }, "navigation": ["Begin", "Next", "Back"], "as": "first" },
    { "request": "begin", "hang": true },
    { "client": "sync", "target": "Details", "fields": { "trigger": "Update", "input": { "email": "bob@example.com", "name": "Bob" } }, "navigation": ["Begin", "Next", "Back"], "as": "second" },
    { "client": "dispose", "expect": { "disposed": true } },
    { "await": "first", "expect": { "outcome": "superseded" } },
    { "await": "second", "expect": { "outcome": "failed", "code": "DISPOSED" } }
  ]
}
