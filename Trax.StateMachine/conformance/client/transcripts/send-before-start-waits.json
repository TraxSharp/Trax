{
  "about": "A send made before start waits for it: the read goes out first, and the event is sent, predicted from what the read answered, only once it has.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "send", "trigger": "Coin", "input": { "coin": "quarter" }, "as": "coin" },
    { "client": "start", "as": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "await": "start", "expect": { "settled": true } },
    { "request": "coin", "variables": { "id": "i-1", "input": { "coin": "quarter" }, "requestId": "r1", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Unlocked\",\"context\":{\"paidWith\":\"quarter\"}}" }, "answer": { "id": "i-1", "revision": 2, "state": "Unlocked", "context": { "paidWith": "quarter" } } },
    { "await": "coin", "expect": { "outcome": "confirmed", "state": "Unlocked", "revision": 2 } }
  ]
}
