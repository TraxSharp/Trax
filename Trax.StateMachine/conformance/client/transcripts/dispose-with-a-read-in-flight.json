{
  "about": "Disposing a client whose first read is in flight settles the start and every send waiting on it, the sends as DISPOSED, and sends nothing more.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start", "as": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "variables": { "id": "i-1" }, "hang": true },
    { "client": "send", "trigger": "Coin", "input": { "coin": "quarter" }, "as": "coin" },
    { "wait": 20 },
    { "client": "dispose", "expect": { "disposed": true } },
    { "await": "coin", "expect": { "outcome": "failed", "code": "DISPOSED" } },
    { "await": "start", "expect": { "settled": true } },
    { "quiet": 50 }
  ]
}
