{
  "about": "A stream error coded CLIENT_OUTDATED stops the client for good, and nothing is subscribed again.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "pushErrors": [{ "message": "Reload.", "extensions": { "code": "CLIENT_OUTDATED" } }] },
    { "view": { "status": "stopped", "error": "CLIENT_OUTDATED" } },
    { "quiet": 50 }
  ]
}
