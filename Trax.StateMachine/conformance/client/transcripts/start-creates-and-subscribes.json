{
  "about": "A client with no instance starts one under its first requestId, subscribes to the id the host minted, and shows the started snapshot. A push of the revision it holds changes nothing.",
  "machine": "turnstile",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start", "as": "start" },
    { "request": "start", "variables": { "requestId": "r1" }, "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": { "paidWith": null } } },
    { "await": "start", "expect": { "settled": true } },
    { "subscribe": { "id": "i-1" } },
    { "view": { "status": "ready", "instance": "i-1", "state": "Locked", "context": {}, "revision": 1, "pending": false, "problem": null } },
    { "push": { "rowId": "7", "revision": 1, "state": "Locked", "context": { "paidWith": null } } },
    { "view": { "status": "ready", "revision": 1, "rowId": null } }
  ]
}
