{
  "about": "Events sent together go one at a time in the order sent, each under its own requestId, each predicted from what the host confirmed before it.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Coin", "input": { "coin": "dollar" }, "as": "coin" },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "view": { "pending": true, "state": "Locked", "context": {} } },
    { "request": "coin", "variables": { "id": "i-1", "input": { "coin": "dollar" }, "requestId": "r1", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Unlocked\",\"context\":{\"paidWith\":\"dollar\"}}" }, "answer": { "id": "i-1", "revision": 2, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "await": "coin", "expect": { "outcome": "confirmed", "revision": 2 } },
    { "request": "push", "variables": { "id": "i-1", "requestId": "r2", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Locked\",\"context\":{}}" }, "answer": { "id": "i-1", "revision": 3, "state": "Locked", "context": {} } },
    { "await": "push", "expect": { "outcome": "confirmed", "revision": 3 } },
    { "view": { "pending": false, "state": "Locked", "revision": 3 } }
  ]
}
