{
  "about": "A request id minter that throws fails the one send it was minting for as INVALID_REQUEST_ID, sends nothing for it, and the controller carries on: the next send goes out under the next id minted.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "open": { "throwingRequestId": 1 },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "expect": { "outcome": "failed", "code": "INVALID_REQUEST_ID" } },
    { "quiet": 50 },
    { "view": { "status": "ready", "state": "Unlocked", "pending": false }, "once": true },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "push", "variables": { "id": "i-1", "requestId": "r1", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Locked\",\"context\":{}}" }, "answer": { "id": "i-1", "revision": 2, "state": "Locked", "context": {} } },
    { "await": "push", "expect": { "outcome": "confirmed", "state": "Locked", "revision": 2 } }
  ]
}
