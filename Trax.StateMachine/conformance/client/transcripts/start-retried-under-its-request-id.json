{
  "about": "A start that fails in transport is retried under the request id it was first sent with, so a host that did create the instance answers with it rather than creating a second.",
  "machine": "turnstile",
  "instance": null,
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start", "as": "start" },
    { "request": "start", "variables": { "requestId": "r1" }, "drop": true },
    { "await": "start", "expect": { "settled": true } },
    { "view": { "status": "loading", "problem": "TRANSPORT_ERROR" } },
    { "client": "retry", "as": "retry" },
    { "request": "start", "variables": { "requestId": "r1" }, "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "await": "retry", "expect": { "outcome": "confirmed", "state": "Locked", "revision": 1 } },
    { "subscribe": { "id": "i-1" } },
    { "view": { "status": "ready", "instance": "i-1" } }
  ]
}
