{
  "about": "A sync the planner cannot plan settles invalid and sends nothing: a navigation trigger bound to the effect, and a fields input nested 600 arrays deep, which the testee builds in memory (tooDeep). The next request the host sees is the event sent after them.",
  "machine": "wizard",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "begin": "$id: UUID!, $requestId: String!, $clientResult: String",
    "update": "$id: UUID!, $input: UpdateInput!, $requestId: String!, $clientResult: String",
    "next": "$id: UUID!, $requestId: String!, $clientResult: String",
    "back": "$id: UUID!, $requestId: String!, $clientResult: String",
    "skip": "$id: UUID!, $requestId: String!, $clientResult: String",
    "send": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Review", "context": { "email": "ada@example.com", "name": "Ada" } } },
    { "view": { "status": "ready", "unsaved": false } },
    { "client": "sync", "target": "Sent", "fields": null, "navigation": ["Send"], "expect": { "outcome": "invalid", "trigger": "Send" } },
    { "client": "sync", "target": "Review", "fields": { "trigger": "Update", "input": [] }, "navigation": ["Begin", "Next", "Back"], "tooDeep": "input", "expect": { "outcome": "invalid", "code": "INVALID_INPUT" } },
    { "view": { "unsaved": true, "pending": false } },
    { "client": "send", "trigger": "Back", "as": "b" },
    { "request": "back", "answer": { "id": "i-1", "revision": 2, "state": "Details", "context": { "email": "ada@example.com", "name": "Ada" } } },
    { "await": "b", "expect": { "outcome": "confirmed", "revision": 2 } }
  ]
}
