{
  "about": "A push asking for a reload makes the client read the instance once.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "push": { "reload": true } },
    { "request": "get", "variables": { "id": "i-1" }, "answer": { "id": "i-1", "revision": 5, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "state": "Unlocked", "revision": 5 } }
  ]
}
