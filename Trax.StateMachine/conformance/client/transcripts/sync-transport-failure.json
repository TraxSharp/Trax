{
  "about": "A sync whose event fails in transport settles failed, and the view stays unsaved; syncing again resumes from what the host confirmed.",
  "machine": "wizard",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "begin": "$id: UUID!, $requestId: String!, $clientResult: String",
    "update": "$id: UUID!, $input: UpdateInput!, $requestId: String!, $clientResult: String",
    "next": "$id: UUID!, $requestId: String!, $clientResult: String",
    "back": "$id: UUID!, $requestId: String!, $clientResult: String",
    "skip": "$id: UUID!, $requestId: String!, $clientResult: String",
    "send": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Details", "context": {} } },
    { "view": { "status": "ready", "unsaved": false } },
    { "client": "sync", "target": "Review", "fields": { "trigger": "Update", "input": { "email": "ada@example.com", "name": "Ada" } }, "navigation": ["Begin", "Next", "Back"], "as": "s" },
    { "request": "update", "drop": true },
    { "await": "s", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "unsaved": true } },
    { "client": "sync", "target": "Review", "fields": { "trigger": "Update", "input": { "email": "ada@example.com", "name": "Ada" } }, "navigation": ["Begin", "Next", "Back"], "as": "again" },
    { "request": "update", "answer": { "id": "i-1", "revision": 2, "state": "Details", "context": { "email": "ada@example.com", "name": "Ada" } } },
    { "request": "next", "answer": { "id": "i-1", "revision": 3, "state": "Review", "context": { "email": "ada@example.com", "name": "Ada" } } },
    { "await": "again", "expect": { "outcome": "synced", "state": "Review", "revision": 3 } },
    { "view": { "unsaved": false } }
  ]
}
