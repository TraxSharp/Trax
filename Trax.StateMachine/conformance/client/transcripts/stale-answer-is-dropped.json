{
  "about": "Snapshots are ordered by revision: an answer older than a push already taken changes nothing.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Coin", "input": { "coin": "dollar" }, "as": "coin" },
    { "push": { "revision": 3, "state": "Locked", "context": {} } },
    { "view": { "confirmed": { "state": "Locked", "context": {} }, "revision": 3 } },
    { "request": "coin", "answer": { "id": "i-1", "revision": 2, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "await": "coin", "expect": { "outcome": "confirmed", "revision": 2 } },
    { "view": { "state": "Locked", "revision": 3, "pending": false } }
  ]
}
