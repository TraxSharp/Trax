{
  "about": "A client that stopped allows nothing: can is false and available is empty, whatever the state it last showed.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "client": "can", "trigger": "Coin", "input": { "coin": "dollar" }, "expect": { "can": true } },
    { "push": { "gone": true } },
    { "view": { "status": "stopped", "error": "GONE" } },
    { "client": "can", "trigger": "Coin", "input": { "coin": "dollar" }, "expect": { "can": false } },
    { "client": "available", "expect": { "triggers": [] } }
  ]
}
