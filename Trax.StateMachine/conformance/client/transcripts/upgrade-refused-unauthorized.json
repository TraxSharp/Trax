{
  "about": "A socket upgrade the host answers 401 stops the client for good as UNAUTHENTICATED, as a socket closed with 4401 does; nothing is subscribed again.",
  "machine": "turnstile",
  "instance": "i-1",
  "needs": ["upgrade-status"],
  "refuseUpgrades": [401],
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "stopped", "error": "UNAUTHENTICATED" } },
    { "quiet": 50 }
  ]
}
