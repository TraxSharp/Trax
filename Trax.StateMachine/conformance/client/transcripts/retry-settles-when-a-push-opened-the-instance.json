{
  "about": "A retry of a failed first read whose own reads fail too still settles confirmed when a push opened the instance while it was retrying.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "retryDelays": [10],
  "steps": [
    { "client": "start", "as": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "variables": { "id": "i-1" }, "status": 503 },
    { "request": "get", "variables": { "id": "i-1" }, "status": 503 },
    { "await": "start", "expect": { "settled": true } },
    { "view": { "status": "loading", "problem": "TRANSPORT_ERROR" } },
    { "client": "retry", "as": "retry" },
    { "request": "get", "variables": { "id": "i-1" }, "status": 503 },
    { "push": { "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1 } },
    { "request": "get", "variables": { "id": "i-1" }, "status": 503 },
    { "await": "retry", "expect": { "outcome": "confirmed", "state": "Unlocked", "revision": 1 } },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1 } }
  ]
}
