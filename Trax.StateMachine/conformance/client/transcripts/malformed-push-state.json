{
  "about": "A push whose state is not a string, or that holds none and says neither gone, reload nor a problem, is dropped and the instance read again, and the client carries on. Each read is the fence its push is checked behind.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "push": { "rowId": null, "revision": 2, "state": 5, "context": {}, "dueAt": null, "dueAtKnown": true, "gone": false, "reload": false, "problem": null }, "bare": true },
    { "request": "get", "variables": { "id": "i-1" }, "hold": "fence" },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1, "error": null }, "once": true },
    { "respond": "fence", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "push": { "rowId": null, "revision": 2, "context": {}, "dueAt": null, "dueAtKnown": true, "gone": false, "reload": false, "problem": null }, "bare": true },
    { "request": "get", "variables": { "id": "i-1" }, "hold": "fence" },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1, "error": null }, "once": true },
    { "respond": "fence", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "push": { "revision": 2, "state": "Locked", "context": {} } },
    { "view": { "status": "ready", "state": "Locked", "revision": 2, "error": null } }
  ]
}
