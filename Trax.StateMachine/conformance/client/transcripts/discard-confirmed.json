{
  "about": "A discard is sent under the next request id and settles discarded once the host says the instance is gone. The view moves only when the stream says so.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "client": "discard", "as": "discard" },
    { "request": "discard", "variables": { "id": "i-1", "requestId": "r1" }, "answer": { "id": "i-1", "discarded": true } },
    { "await": "discard", "expect": { "outcome": "discarded" } },
    { "view": { "status": "ready", "state": "Locked" } },
    { "push": { "gone": true } },
    { "view": { "status": "stopped", "error": "GONE", "deleted": true } }
  ]
}
