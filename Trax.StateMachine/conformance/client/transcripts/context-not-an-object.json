{
  "about": "A context that is not an object is not one a store wrote: an answer that holds one fails as TRANSPORT_ERROR and changes nothing, and a push that holds one is dropped. The read a reload push makes the client send is the fence the dropped push is checked behind.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "push", "answer": { "id": "i-1", "revision": 2, "state": "Locked", "context": ["not", "an", "object"] } },
    { "await": "push", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "state": "Unlocked", "revision": 1, "pending": false, "problem": "TRANSPORT_ERROR" } },
    { "push": { "revision": 3, "state": "Locked", "context": 5 } },
    { "push": { "reload": true } },
    { "request": "get", "variables": { "id": "i-1" }, "hold": "fence" },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1 }, "once": true },
    { "respond": "fence", "answer": { "id": "i-1", "revision": 3, "state": "Locked", "context": {} } },
    { "view": { "state": "Locked", "revision": 3, "pending": false } }
  ]
}
