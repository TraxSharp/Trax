{
  "about": "An event that failed is not resent once a later event has gone out after it: retry while the later one is in flight answers NOTHING_TO_RETRY, and the failed event is never sent behind the later one, out of order and predicted from a state the host has moved past.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "as": "first" },
    { "client": "send", "trigger": "Coin", "input": { "coin": "quarter" }, "as": "second" },
    { "request": "push", "drop": true },
    { "await": "first", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "wait": 50 },
    { "client": "retry", "expect": { "outcome": "failed", "code": "NOTHING_TO_RETRY" } },
    { "request": "coin", "answer": { "id": "i-1", "revision": 2, "state": "Unlocked", "context": { "paidWith": "quarter" } } },
    { "await": "second", "expect": { "outcome": "confirmed", "revision": 2 } },
    { "view": { "pending": false, "state": "Unlocked", "revision": 2 } },
    { "quiet": 50 }
  ]
}
