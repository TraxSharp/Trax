    { "view": { "status": "ready", "state": "Idle", "dueAt": null } },
    { "push": { "rowId": null, "revision": 2, "state": "Review", "context": {}, "gone": false, "reload": false, "problem": null }, "bare": true },
    { "request": "get", "variables": { "id": "i-1" }, "answer": { "id": "i-1", "revision": 2, "state": "Review", "context": {}, "dueAt": "2026-10-22T10:10:00Z" } },
    { "view": { "state": "Review", "revision": 2, "dueAt": "2026-10-22T10:10:00Z" } },
    { "push": { "rowId": null, "revision": 3, "state": "Review", "context": {}, "gone": false, "reload": false, "problem": null }, "bare": true },
    { "view": { "revision": 3, "dueAt": "2026-10-22T10:10:00Z" } }
  ]
