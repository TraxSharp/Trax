{
  "about": "A change listener that throws on every change is the page's bug: the controller still settles each send and shows each change.",
  "machine": "turnstile",
  "instance": "i-1",
  "needs": ["change-listener"],
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "open": { "throwingListener": true },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "push", "answer": { "id": "i-1", "revision": 2, "state": "Locked", "context": {} } },
    { "await": "push", "expect": { "outcome": "confirmed", "state": "Locked", "revision": 2 } },
    { "push": { "revision": 3, "state": "Unlocked", "context": { "paidWith": "quarter" } } },
    { "view": { "state": "Unlocked", "revision": 3, "pending": false } }
  ]
}
