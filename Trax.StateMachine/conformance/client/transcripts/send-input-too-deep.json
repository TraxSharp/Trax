{
  "about": "A send whose input nests deeper than a value may (512 levels) is refused where it is sent as INVALID_INPUT, and nothing reaches the host.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Coin", "tooDeep": "input", "expect": { "outcome": "refused", "code": "INVALID_INPUT" } },
    { "quiet": 50 },
    { "view": { "status": "ready", "state": "Locked", "pending": false }, "once": true }
  ]
}
