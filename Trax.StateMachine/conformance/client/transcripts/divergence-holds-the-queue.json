{
  "about": "A CLIENT_DIVERGENCE answer holds the queue: the event queued behind the refused one is not sent until the read the refusal starts has settled, and is predicted from what that read says.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Coin", "input": { "coin": "quarter" }, "as": "coin" },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "coin", "variables": { "id": "i-1", "input": { "coin": "quarter" }, "requestId": "r1", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Unlocked\",\"context\":{\"paidWith\":\"quarter\"}}" }, "answer": { "problem": { "code": "CLIENT_DIVERGENCE", "message": "The engines disagree." } } },
    { "await": "coin", "expect": { "outcome": "refused", "code": "CLIENT_DIVERGENCE" } },
    { "request": "get", "variables": { "id": "i-1" }, "answer": { "id": "i-1", "revision": 2, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "request": "push", "variables": { "id": "i-1", "requestId": "r2", "clientResult": "{\"machine\":\"turnstile\",\"version\":1,\"state\":\"Locked\",\"context\":{}}" }, "answer": { "id": "i-1", "revision": 3, "state": "Locked", "context": {} } },
    { "await": "push", "expect": { "outcome": "confirmed", "state": "Locked", "revision": 3 } },
    { "view": { "state": "Locked", "revision": 3, "pending": false } }
  ]
}
