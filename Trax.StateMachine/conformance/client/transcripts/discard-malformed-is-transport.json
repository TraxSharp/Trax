{
  "about": "A discard whose answer is not JSON, or says discarded with something other than true, settles failed as TRANSPORT_ERROR, a value and never a throw.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "client": "discard", "as": "first" },
    { "request": "discard", "variables": { "id": "i-1", "requestId": "r1" }, "raw": "<html>not json</html>" },
    { "await": "first", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "client": "discard", "as": "second" },
    { "request": "discard", "variables": { "id": "i-1", "requestId": "r2" }, "answer": { "id": "i-1", "discarded": "yes" } },
    { "await": "second", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "status": "ready", "state": "Locked" } }
  ]
}
