{
  "about": "A client opened without a maxResponseSize reads an answer of up to 16 MiB: one of exactly 16 MiB is taken, and one a byte larger fails its request as TRANSPORT_ERROR and changes nothing.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } }, "padTo": 16777216 },
    { "view": { "status": "ready", "state": "Unlocked", "revision": 1 } },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "push", "answer": { "id": "i-1", "revision": 2, "state": "Locked", "context": {} }, "padTo": 16777217 },
    { "await": "push", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "state": "Unlocked", "revision": 1, "pending": false, "problem": "TRANSPORT_ERROR" } }
  ]
}
