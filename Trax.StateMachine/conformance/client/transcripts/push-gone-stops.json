{
  "about": "A push saying the instance was deleted stops the client as GONE, deleted.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "push": { "gone": true } },
    { "view": { "status": "stopped", "error": "GONE", "deleted": true } },
    { "client": "send", "trigger": "Coin", "input": { "coin": "dollar" }, "expect": { "outcome": "stopped", "code": "GONE" } }
  ]
}
