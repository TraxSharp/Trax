{
  "about": "A discard the host refuses settles refused with its code, and the client goes on as it was.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Locked", "context": {} } },
    { "view": { "status": "ready" } },
    { "client": "discard", "as": "discard" },
    { "request": "discard", "variables": { "id": "i-1", "requestId": "r1" }, "answer": { "id": "i-1", "discarded": false, "problem": { "code": "DISCARD_NOT_ALLOWED", "message": "This instance cannot be discarded." } } },
    { "await": "discard", "expect": { "outcome": "refused", "code": "DISCARD_NOT_ALLOWED" } },
    { "view": { "status": "ready", "state": "Locked", "problem": null } }
  ]
}
