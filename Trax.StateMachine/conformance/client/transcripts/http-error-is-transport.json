{
  "about": "A host that answers an event with an HTTP 503 and no body has not answered it: TRANSPORT_ERROR, as a value.",
  "machine": "turnstile",
  "instance": "i-1",
  "documents": {
    "start": "$requestId: String!",
    "coin": "$id: UUID!, $input: CoinInput!, $requestId: String!, $clientResult: String",
    "push": "$id: UUID!, $requestId: String!, $clientResult: String",
    "get": "$id: UUID!",
    "discard": "$id: UUID!, $requestId: String!",
    "changed": "$id: UUID!"
  },
  "steps": [
    { "client": "start" },
    { "subscribe": { "id": "i-1" } },
    { "request": "get", "answer": { "id": "i-1", "revision": 1, "state": "Unlocked", "context": { "paidWith": "dollar" } } },
    { "view": { "status": "ready" } },
    { "client": "send", "trigger": "Push", "as": "push" },
    { "request": "push", "status": 503 },
    { "await": "push", "expect": { "outcome": "failed", "code": "TRANSPORT_ERROR" } },
    { "view": { "state": "Unlocked", "problem": "TRANSPORT_ERROR" } }
  ]
}
