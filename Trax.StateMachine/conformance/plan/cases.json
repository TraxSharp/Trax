{
  "_comment": "Planner cases (PROTOCOL.md, plan). Each plans from 'given' to 'target' over the wizard machine in wizard.ir.json, with 'fields' (the fields event and its input, or null) and 'navigation'; 'maxDepth' when given. 'expect' is the planner's answer, compared exactly.",
  "machine": "wizard",
  "cases": [
    {"name": "start-to-review-fills-on-the-way", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Review", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "plan", "events": [{"trigger": "Begin"}, {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, {"trigger": "Next"}]}},
    {"name": "already-there-plans-nothing", "given": {"machine": "wizard", "version": 1, "state": "Review", "context": {"email": "ada@example.com", "name": "Ada"}}, "target": "Review", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "plan", "events": []}},
    {"name": "other-fields-at-the-target-are-updated", "given": {"machine": "wizard", "version": 1, "state": "Review", "context": {"email": "bob@example.com", "name": "Bob"}}, "target": "Review", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "plan", "events": [{"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}]}},
    {"name": "back-a-step", "given": {"machine": "wizard", "version": 1, "state": "Review", "context": {"email": "ada@example.com", "name": "Ada"}}, "target": "Details", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "plan", "events": [{"trigger": "Back"}]}},
    {"name": "no-fields-event", "given": {"machine": "wizard", "version": 1, "state": "Details", "context": {"email": "ada@example.com", "name": "Ada"}}, "target": "Review", "fields": null, "navigation": ["Next"], "expect": {"result": "plan", "events": [{"trigger": "Next"}]}},
    {"name": "the-guard-reads-the-fields-so-they-go-first", "given": {"machine": "wizard", "version": 1, "state": "Details", "context": {"email": null, "name": null}}, "target": "Review", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Next", "Back"], "expect": {"result": "plan", "events": [{"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, {"trigger": "Next"}]}},
    {"name": "a-state-only-an-effect-reaches-is-unreachable", "given": {"machine": "wizard", "version": 1, "state": "Review", "context": {"email": "ada@example.com", "name": "Ada"}}, "target": "Sent", "fields": null, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "unreachable"}},
    {"name": "fields-the-target-cannot-take-are-unreachable", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Start", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "unreachable"}},
    {"name": "fields-the-input-refuses-are-unreachable", "given": {"machine": "wizard", "version": 1, "state": "Details", "context": {"email": null, "name": null}}, "target": "Review", "fields": {"trigger": "Update", "input": {"name": "Ada"}}, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "unreachable"}},
    {"name": "a-custom-guard-is-undetermined", "given": {"machine": "wizard", "version": 1, "state": "Details", "context": {"email": null, "name": null}}, "target": "Review", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Skip"], "expect": {"result": "undetermined", "trigger": "Skip", "events": []}},
    {"name": "a-determined-plan-beats-a-custom-guard", "given": {"machine": "wizard", "version": 1, "state": "Details", "context": {"email": null, "name": null}}, "target": "Review", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Skip", "Next"], "expect": {"result": "plan", "events": [{"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, {"trigger": "Next"}]}},
    {"name": "a-depth-limit-reached-is-exceeded", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Review", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Next", "Back"], "maxDepth": 1, "expect": {"result": "exceeded"}},
    {"name": "an-effect-trigger-cannot-navigate", "given": {"machine": "wizard", "version": 1, "state": "Review", "context": {"email": null, "name": null}}, "target": "Sent", "fields": null, "navigation": ["Next", "Send"], "expect": {"result": "invalid", "trigger": "Send"}},
    {"name": "a-timer-cannot-navigate", "given": {"machine": "wizard", "version": 1, "state": "Review", "context": {"email": null, "name": null}}, "target": "Details", "fields": null, "navigation": ["Review.after"], "expect": {"result": "invalid", "trigger": "Review.after"}},
    {"name": "an-unknown-trigger-cannot-navigate", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Details", "fields": null, "navigation": ["Fly"], "expect": {"result": "invalid", "trigger": "Fly"}},
    {"name": "the-fields-event-is-not-navigation", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Details", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Update"], "expect": {"result": "invalid", "trigger": "Update"}},
    {"name": "an-unknown-target", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Nowhere", "fields": null, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "invalid", "target": "Nowhere"}}
  ]
}
