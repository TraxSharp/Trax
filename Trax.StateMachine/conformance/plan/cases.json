    {"name": "a-fields-event-on-a-custom-rule-at-the-target-is-undetermined-there", "machine": "notebook", "given": {"machine": "notebook", "version": 1, "state": "Draft", "context": {"notes": 2}}, "target": "Draft", "fields": {"trigger": "Note"}, "navigation": ["File", "Reopen"], "expect": {"result": "undetermined", "trigger": "Note", "events": []}},
    {"name": "a-depth-limit-reached-is-exceeded", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Review", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Next", "Back"], "maxDepth": 1, "expect": {"result": "exceeded"}},
    {"name": "an-effect-trigger-cannot-navigate", "given": {"machine": "wizard", "version": 1, "state": "Review", "context": {"email": null, "name": null}}, "target": "Sent", "fields": null, "navigation": ["Next", "Send"], "expect": {"result": "invalid", "trigger": "Send"}},
    {"name": "a-timer-cannot-navigate", "given": {"machine": "wizard", "version": 1, "state": "Review", "context": {"email": null, "name": null}}, "target": "Details", "fields": null, "navigation": ["Review.after"], "expect": {"result": "invalid", "trigger": "Review.after"}},
    {"name": "an-unknown-trigger-cannot-navigate", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Details", "fields": null, "navigation": ["Fly"], "expect": {"result": "invalid", "trigger": "Fly"}},
    {"name": "the-fields-event-is-not-navigation", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Details", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Begin", "Update"], "expect": {"result": "invalid", "trigger": "Update"}},
    {"name": "a-declared-trigger-with-no-transition-cannot-navigate", "machine": "notebook", "given": {"machine": "notebook", "version": 1, "state": "Draft", "context": {"notes": 0}}, "target": "Filed", "fields": null, "navigation": ["File", "Archive"], "expect": {"result": "invalid", "trigger": "Archive"}},
    {"name": "a-fields-input-nested-too-deep-is-invalid-first", "given": {"machine": "wizard", "version": 1, "state": "Details", "context": {"email": null, "name": null}}, "target": "Nowhere", "fields": {"trigger": "Update", "input": []}, "navigation": ["Fly"], "tooDeep": "input", "expect": {"result": "invalid", "code": "INVALID_INPUT"}},
    {"name": "a-context-nested-too-deep-is-invalid-before-the-target", "given": {"machine": "wizard", "version": 1, "state": "Details", "context": {"email": null, "name": null}}, "target": "Nowhere", "fields": {"trigger": "Update", "input": {"email": "ada@example.com", "name": "Ada"}}, "navigation": ["Fly"], "tooDeep": "context", "expect": {"result": "invalid", "code": "INVALID_CONTEXT"}},
    {"name": "an-unknown-target", "given": {"machine": "wizard", "version": 1, "state": "Start", "context": {"email": null, "name": null}}, "target": "Nowhere", "fields": null, "navigation": ["Begin", "Next", "Back"], "expect": {"result": "invalid", "target": "Nowhere"}},
    {"name": "odometer-a-goal-the-last-expansion-allowed-reaches-is-planned", "machine": "odometer", "given": {"machine": "odometer", "version": 1, "state": "Driving", "context": {"d0": 0, "d1": 0, "d2": 0, "d3": 0}}, "target": "Done", "fields": null, "navigation": ["D0", "D1", "D2", "D3", "Finish"], "maxDepth": 40, "expect": {"result": "plan", "events": [{"trigger": "D0"}, {"trigger": "D0"}, {"trigger": "D0"}, {"trigger": "D0"}, {"trigger": "D0"}, {"trigger": "D0"}, {"trigger": "D0"}, {"trigger": "D0"}, {"trigger": "D0"}, {"trigger": "D1"}, {"trigger": "D1"}, {"trigger": "D1"}, {"trigger": "D1"}, {"trigger": "D1"}, {"trigger": "D1"}, {"trigger": "D1"}, {"trigger": "D1"}, {"trigger": "D1"}, {"trigger": "D2"}, {"trigger": "D2"}, {"trigger": "D2"}, {"trigger": "D2"}, {"trigger": "D2"}, {"trigger": "D2"}, {"trigger": "D2"}, {"trigger": "D2"}, {"trigger": "D2"}, {"trigger": "D3"}, {"trigger": "D3"}, {"trigger": "D3"}, {"trigger": "D3"}, {"trigger": "D3"}, {"trigger": "D3"}, {"trigger": "D3"}, {"trigger": "D3"}, {"trigger": "D3"}, {"trigger": "Finish"}]}},
    {"name": "odometer-a-goal-one-expansion-past-the-limit-is-exceeded", "machine": "odometer", "given": {"machine": "odometer", "version": 1, "state": "Parked", "context": {"d0": 0, "d1": 0, "d2": 0, "d3": 0}}, "target": "Done", "fields": null, "navigation": ["Start", "D0", "D1", "D2", "D3", "Finish"], "maxDepth": 40, "expect": {"result": "exceeded"}},
    {"name": "odometer-ten-thousand-snapshots-and-no-goal-are-unreachable", "machine": "odometer", "given": {"machine": "odometer", "version": 1, "state": "Driving", "context": {"d0": 0, "d1": 0, "d2": 0, "d3": 0}}, "target": "Done", "fields": null, "navigation": ["D0", "D1", "D2", "D3"], "maxDepth": 40, "expect": {"result": "unreachable"}},
    {"name": "odometer-ten-thousand-and-one-snapshots-and-no-goal-are-exceeded", "machine": "odometer", "given": {"machine": "odometer", "version": 1, "state": "Parked", "context": {"d0": 0, "d1": 0, "d2": 0, "d3": 0}}, "target": "Done", "fields": null, "navigation": ["Start", "D0", "D1", "D2", "D3"], "maxDepth": 40, "expect": {"result": "exceeded"}}
