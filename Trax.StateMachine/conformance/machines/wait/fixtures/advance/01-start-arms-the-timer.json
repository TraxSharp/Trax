{
  "name": "Start enters Fetching, whose timer reads its duration from the context",
  "given": {
    "machine": "wait",
    "version": 1,
    "state": "Idle",
    "context": {
      "source": "s3://bucket/a",
      "patience": "PT5M"
    }
  },
  "when": {
    "trigger": "Start"
  },
  "expect": {
    "outcome": "transitioned",
    "snapshot": {
      "machine": "wait",
      "version": 1,
      "state": "Fetching",
      "context": {
        "source": "s3://bucket/a",
        "patience": "PT5M"
      }
    }
  }
}
