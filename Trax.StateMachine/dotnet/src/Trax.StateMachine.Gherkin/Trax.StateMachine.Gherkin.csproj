<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Trax.StateMachine.Gherkin</AssemblyName>
    <Description>Derive Trax .NET state machines from Gherkin features and a glossary: each machine's portable IR and the host file that says who may use it, checked by replaying every scenario on what was derived.</Description>
    <PackageTags>trax;statemachine;gherkin;cucumber;bdd</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.StateMachine/Trax.StateMachine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cucumber's own parser: Backgrounds, Rules, outlines and And/But arrive as pickles with file:line. -->
    <PackageReference Include="Gherkin" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.StateMachine.Tests" />
    <!-- The `trax machine` commands report more than the public calls return (step usage, the run's step kinds), and
         the CLI ships built against this commit. Its assembly is named `trax`. -->
    <InternalsVisibleTo Include="trax" />
    <!-- The Reqnroll bindings step through the runner with a host driver. -->
    <InternalsVisibleTo Include="Trax.StateMachine.Gherkin.Reqnroll" />
    <InternalsVisibleTo Include="Trax.Api.Tests.StateMachine.E2E" />
  </ItemGroup>
</Project>
