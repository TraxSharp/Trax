<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Portable, resumable snapshot state-machine engine. Pure: no database or I/O. Represents a multi-step flow's state as language-neutral JSON so a C# backend and a TypeScript client agree on it, with illegal (state, context) pairs unrepresentable and every operation total.</Description>
    <AssemblyName>Trax.StateMachine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- A state that invokes a train names it by its IServiceTrain interface, which carries the train's input and output types. -->
    <ProjectReference Include="../../../../Trax.Effect/src/Trax.Effect/Trax.Effect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.StateMachine.Tests" />
    <!-- Reads the exception behind an internal-error rejection, to log it without returning its text; and, for a
         state that invokes a train, reads the invoke declarations and the reserved states, and applies outcomes. -->
    <InternalsVisibleTo Include="Trax.StateMachine.Persistence" />
    <InternalsVisibleTo Include="Trax.StateMachine.Persistence.Integration" />
    <!-- Applies an outcome to a machine whose train only the mediator's tests can declare. -->
    <InternalsVisibleTo Include="Trax.Mediator.Tests.StateMachine.Integration" />
    <!-- Compares the rule of each event entering an invoking state with the train's [TraxAuthorize] at startup. -->
    <InternalsVisibleTo Include="Trax.Mediator" />
    <!-- Writes and reads a TimeSpan on the typed machine surface as the ISO-8601 duration a timer reads. -->
    <InternalsVisibleTo Include="Trax.Api.GraphQL" />
    <!-- Reads which edges a machine built from the IR cannot evaluate, so the client sends those with no prediction. -->
    <InternalsVisibleTo Include="Trax.StateMachine.Client" />
    <!-- Serves a machine from its IR and host entry through the GraphQL surface, with no C# class to name. -->
    <InternalsVisibleTo Include="Trax.Api.Tests" />
    <!-- Derives machines from features: reads the glossary, writes the IR in the exporter's canonical form, and replays
         every scenario on what it derived with the engine's own rule and reduction readers. -->
    <InternalsVisibleTo Include="Trax.StateMachine.Gherkin" />
    <InternalsVisibleTo Include="Trax.Api.Tests.StateMachine.E2E" />
    <!-- `trax machine from-gherkin` reads the glossary it derives from, to name a bad one's key. The CLI's assembly is
         named `trax`. -->
    <InternalsVisibleTo Include="trax" />
    <!-- The Reqnroll bindings read the glossary and host file. -->
    <InternalsVisibleTo Include="Trax.StateMachine.Gherkin.Reqnroll" />
    <!-- The operations service draws the board of machines served from features from their host file. -->
    <InternalsVisibleTo Include="Trax.Scheduler" />
  </ItemGroup>
</Project>
