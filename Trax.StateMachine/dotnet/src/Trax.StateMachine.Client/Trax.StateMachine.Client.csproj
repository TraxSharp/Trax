<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Drive a Trax state machine a host serves from .NET: Blazor, MAUI, Avalonia, WPF or another service. Sends each operation by the persisted id the host's client manifest lists, follows the instance over a graphql-transport-ws socket, predicts each event with the Trax.StateMachine engine and replaces the prediction with what the server stored. Every operation answers a refusal or a transport failure as a value.</Description>
    <AssemblyName>Trax.StateMachine.Client</AssemblyName>
    <PackageTags>trax;dotnet;state-machine;graphql;blazor;maui</PackageTags>
    <!-- A new package id, so nuget.org has no release to validate against yet. Remove after the first release that
         ships it (Directory.Build.props). -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine only: the client predicts with it and reads the host's manifest with it. Never Trax.Api.*, so a
         MAUI or Blazor WebAssembly app can reference it. -->
    <ProjectReference Include="../Trax.StateMachine/Trax.StateMachine.csproj" />
    <!-- The transport: POST by id and the graphql-transport-ws socket. -->
    <ProjectReference Include="../Trax.Client/Trax.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.StateMachine.Tests" />
  </ItemGroup>
</Project>
