<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Trax.Samples.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Authors>Theauxm,mark-keaton</Authors>
    <PackageDescription>Project templates for Trax .NET - GraphQL API and Scheduler with Dashboard for .NET</PackageDescription>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TraxSharp/Trax</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet-new;templates;trax;workflows;railway-oriented-programming;graphql;api;scheduler;dashboard</PackageTags>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTemplatePackageVersions</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lockfiles hold this repo's restore of the template projects, not a consumer's. -->
    <Content Include="content/**" Exclude="**/bin/**;**/obj/**;**/packages.lock.json" />
    <Compile Remove="**/*" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The template projects carry no versions: in this repo they take third-party versions from the
    root Directory.Packages.props and build the Trax packages from source (see
    content/Directory.Build.targets), neither of which a scaffolded project sees. At pack time each
    template gets its own Directory.Packages.props, holding the pin of every package its projects
    (the application and its tests/ project) reference and of every Trax package their committed
    lockfiles resolve, with transitive pinning on. Every Trax package is pinned at the version
    being packed, which is the version every Trax package releases at
    (Trax.Docs/adr/0042-trax-is-one-repository-and-releases-at-one-version.md). Pinning only the
    direct references let a transitive Trax package float to whatever version a referenced package
    was built against, which is not the version this repo tests. The package ships exactly the
    versions this repo builds and tests against, and nothing else.
    It is generated into obj/ rather than kept beside the template, where it would shadow the
    root pins inside the repo. docs/adr/0004-the-template-package-carries-its-package-versions.md
  -->
  <ItemGroup>
    <_TraxTemplateProject
      Include="content/**/*.csproj"
      Exclude="content/**/bin/**;content/**/obj/**"
    >
      <!-- content/<template>/..., so the first directory under content/ names the template. -->
      <TemplateName>$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/').Split('/')[0])</TemplateName>
    </_TraxTemplateProject>
    <!-- Every Trax package this repository builds: the csproj file names under each folder's src/. -->
    <_TraxPackageProject
      Include="../../Trax.*/src/**/*.csproj"
      Exclude="../../Trax.*/src/**/bin/**;../../Trax.*/src/**/obj/**"
    />
    <_TraxPackageId Include="@(_TraxPackageProject->'%(Filename)')" />
  </ItemGroup>

  <Target Name="PackTemplatePackageVersions" DependsOnTargets="_WriteTemplatePackageVersions">
    <ItemGroup>
      <TfmSpecificPackageFile
        Include="@(_TraxTemplatePackageVersionsFile)"
        PackagePath="$(ContentTargetFolders)/content/%(TemplateName)/Directory.Packages.props"
      />
    </ItemGroup>
  </Target>

  <Target Name="_WriteTemplatePackageVersions" Outputs="%(_TraxTemplateProject.TemplateName)">
    <PropertyGroup>
      <_TemplateName>%(_TraxTemplateProject.TemplateName)</_TemplateName>
      <_TemplateVersionsFile>$(IntermediateOutputPath)template-versions/$(_TemplateName)/Directory.Packages.props</_TemplateVersionsFile>
    </PropertyGroup>

    <XmlPeek
      XmlInputPath="%(_TraxTemplateProject.FullPath)"
      Query="/Project/ItemGroup/PackageReference/@Include"
    >
      <Output TaskParameter="Result" ItemName="_TemplateReferenceRaw" />
    </XmlPeek>

    <!-- Every Trax package the template's restore resolves, direct or transitive. Each top-level
         entry in packages.lock.json is a line of the form `"Id": {`; the ids nested under an
         entry's dependencies end in a version string instead, so they are not matched. In this
         repo a Trax package is a project, which the lockfile may name in lower case; the match
         ignores case, and the id is taken from the project list so it keeps its own casing. -->
    <ReadLinesFromFile File="%(_TraxTemplateProject.RootDir)%(_TraxTemplateProject.Directory)packages.lock.json">
      <Output TaskParameter="Lines" ItemName="_TemplateLockLine" />
    </ReadLinesFromFile>

    <ItemGroup>
      <_TemplateReference Include="@(_TemplateReferenceRaw->Distinct())" />
      <_TemplateLockedTraxRaw
        Include="$([System.Text.RegularExpressions.Regex]::Replace('%(_TemplateLockLine.Identity)', '^\s*&quot;([^&quot;]+)&quot;:\s*\{\s*$', '$1'))"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_TemplateLockLine.Identity)', '(?i)^\s*&quot;Trax\.[^&quot;]+&quot;:\s*\{\s*$'))"
      />
      <!-- A lockfile also names the template's own projects (the tests project lists the
           application it references), which are not packages; keep only the Trax packages. -->
      <_TemplateLockedOther Include="@(_TemplateLockedTraxRaw)" Exclude="@(_TraxPackageId)" />
      <_TemplateLockedTrax Include="@(_TemplateLockedTraxRaw)" Exclude="@(_TemplateLockedOther)" />
      <_TemplateNeeded Include="@(_TemplateReference);@(_TemplateLockedTrax)" />
      <!-- Item matching ignores case, so these keep the project list's casing. -->
      <_TemplateTraxUnneeded Include="@(_TraxPackageId)" Exclude="@(_TemplateNeeded)" />
      <_TemplateTraxPin
        Include="@(_TraxPackageId)"
        Exclude="@(_TemplateTraxUnneeded)"
        Version="$(Version)"
      />
      <_TemplateUnpinned
        Include="@(_TemplateNeeded)"
        Exclude="@(PackageVersion);@(_TraxPackageId)"
      />
      <_TemplateUnreferenced Include="@(PackageVersion)" Exclude="@(_TemplateNeeded)" />
      <_TemplatePin Include="@(PackageVersion)" Exclude="@(_TemplateUnreferenced)" />
      <_TemplatePin Include="@(_TemplateTraxPin)" />
    </ItemGroup>

    <PropertyGroup>
      <_TemplateVersionsText>&lt;Project&gt;
  &lt;PropertyGroup&gt;
    &lt;ManagePackageVersionsCentrally&gt;true&lt;/ManagePackageVersionsCentrally&gt;
    &lt;CentralPackageTransitivePinningEnabled&gt;true&lt;/CentralPackageTransitivePinningEnabled&gt;
  &lt;/PropertyGroup&gt;
  &lt;ItemGroup&gt;
@(_TemplatePin->'    &lt;PackageVersion Include=&quot;%(Identity)&quot; Version=&quot;%(Version)&quot; /&gt;', '%0A')
  &lt;/ItemGroup&gt;
&lt;/Project&gt;</_TemplateVersionsText>
    </PropertyGroup>

    <Error
      Condition="!Exists('%(_TraxTemplateProject.RootDir)%(_TraxTemplateProject.Directory)packages.lock.json')"
      Text="$(_TemplateName) has no packages.lock.json, so the Trax packages it resolves transitively cannot be pinned. Restore it and commit the lockfile."
    />

    <Error
      Condition="'@(_TemplateUnpinned)' != ''"
      Text="$(_TemplateName) resolves @(_TemplateUnpinned) with no PackageVersion in Directory.Packages.props and no Trax project of that name, so the packed template could not pin it. Pin it there."
    />

    <WriteLinesToFile
      File="$(_TemplateVersionsFile)"
      Lines="$(_TemplateVersionsText)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />

    <ItemGroup>
      <_TraxTemplatePackageVersionsFile
        Include="$(_TemplateVersionsFile)"
        TemplateName="$(_TemplateName)"
      />
      <_TemplateReferenceRaw Remove="@(_TemplateReferenceRaw)" />
      <_TemplateReference Remove="@(_TemplateReference)" />
      <_TemplateLockLine Remove="@(_TemplateLockLine)" />
      <_TemplateLockedTraxRaw Remove="@(_TemplateLockedTraxRaw)" />
      <_TemplateLockedOther Remove="@(_TemplateLockedOther)" />
      <_TemplateLockedTrax Remove="@(_TemplateLockedTrax)" />
      <_TemplateNeeded Remove="@(_TemplateNeeded)" />
      <_TemplateTraxUnneeded Remove="@(_TemplateTraxUnneeded)" />
      <_TemplateTraxPin Remove="@(_TemplateTraxPin)" />
      <_TemplateUnpinned Remove="@(_TemplateUnpinned)" />
      <_TemplateUnreferenced Remove="@(_TemplateUnreferenced)" />
      <_TemplatePin Remove="@(_TemplatePin)" />
    </ItemGroup>
  </Target>
</Project>
