<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The test project lives under tests/; keep its files out of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- `dotnet publish -t:PublishContainer` builds this project's image without a Dockerfile: the
       ASP.NET runtime image, running as its non-root user, named after the project and serving on
       8080, the port the runtime image listens on. -->
  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
  </ItemGroup>

  <!-- Versions live in Directory.Packages.props, beside this file. -->
  <ItemGroup>
    <PackageReference Include="Trax.Core" />
    <PackageReference Include="Trax.Effect" />
    <PackageReference Include="Trax.Effect.Data.InMemory" />
    <PackageReference Include="Trax.Effect.Provider.Parameter" />
    <PackageReference Include="Trax.Effect.JunctionProvider.Progress" />
    <PackageReference Include="Trax.Mediator" />
    <PackageReference Include="Trax.Scheduler" />
    <PackageReference Include="Trax.Api.Auth.ApiKey" />
    <PackageReference Include="Trax.Api.GraphQL" />
    <PackageReference Include="Trax.Api.Dashboard" />
  </ItemGroup>
</Project>
