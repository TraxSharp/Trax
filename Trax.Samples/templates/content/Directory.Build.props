<Project>
  <!-- Block root Directory.Build.props from applying to template content. This file sits above the
       template folders, so it is never scaffolded: what it sets applies only inside this repo. -->
  <PropertyGroup>
    <!-- Restore the template projects against their committed lockfiles, as every other project
         here does. See the root Directory.Build.props. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- A scaffolded project gets the profile only when asked (the templates' strict option), but
       the templates' own code is held to it here, as every sample is. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../Trax.Analyzers/Trax.Analyzers.InRepo.props" />
</Project>
