<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Microsoft.Playwright is referenced from test projects only (Trax.Docs/adr/0049). -->
    <IsTestProject>true</IsTestProject>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host runs as a process of its own, started from its build output beside these tests. -->
    <ProjectReference Include="..\..\samples\CheckIn\Trax.Samples.CheckIn.Api\Trax.Samples.CheckIn.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="..\Trax.Samples.CheckIn.E2E\Fixtures\TestPostgres.cs"
      Link="Shared\TestPostgres.cs"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
</Project>
