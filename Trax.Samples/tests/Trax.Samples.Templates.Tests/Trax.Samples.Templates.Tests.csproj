<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\templates\content\Trax.Samples.Hub\Trax.Samples.Hub.csproj" />
    <ProjectReference Include="..\..\templates\content\Trax.Samples.Scheduler\Trax.Samples.Scheduler.csproj" />
    <ProjectReference Include="..\..\templates\content\Trax.Samples.Api\Trax.Samples.Api.csproj" />
  </ItemGroup>

  <!-- The scaffold feed packs Trax.Analyzers for the templates' strict option. Referencing its
       packaging project puts it, and the Roslyn builds it packs, in this project's restore graph,
       so the packages are restored before the tests run, which may not reach the network. -->
  <ItemGroup>
    <ProjectReference
      Include="..\..\..\Trax.Analyzers\src\Trax.Analyzers.Package\Trax.Analyzers.Package.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
</Project>
