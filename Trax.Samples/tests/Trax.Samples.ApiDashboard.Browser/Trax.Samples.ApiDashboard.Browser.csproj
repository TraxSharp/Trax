<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Microsoft.Playwright is referenced from test projects only (Trax.Docs/adr/0049). -->
    <IsTestProject>true</IsTestProject>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host the browser opens is built here, in the test process: Trax on Postgres (the one
         database CI provisions for this suite), the GraphQL endpoint behind API keys and persisted
         operations, and the dashboard the package serves. -->
    <ProjectReference Include="..\..\..\Trax.Api\src\Trax.Api.Dashboard\Trax.Api.Dashboard.csproj" />
    <ProjectReference Include="..\..\..\Trax.Api\src\Trax.Api.Auth.ApiKey\Trax.Api.Auth.ApiKey.csproj" />
    <ProjectReference Include="..\..\..\Trax.Api\src\Trax.Api.GraphQL.PersistedOperations\Trax.Api.GraphQL.PersistedOperations.csproj" />
    <ProjectReference Include="..\..\..\Trax.Effect\src\Trax.Effect.Data.Postgres\Trax.Effect.Data.Postgres.csproj" />
    <ProjectReference Include="..\..\..\Trax.Effect\src\Trax.Effect.JunctionProvider.Progress\Trax.Effect.JunctionProvider.Progress.csproj" />
    <ProjectReference Include="..\..\..\Trax.Effect\src\Trax.Effect.Provider.Parameter\Trax.Effect.Provider.Parameter.csproj" />
    <ProjectReference Include="..\..\lib\Trax.Samples.Shared.Testing\Trax.Samples.Shared.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
</Project>
