{
  "version": 1,
  "actors": {
    "customer": { "noun": "a customer", "roles": ["customer"] },
    "baker": { "noun": "a baker", "roles": ["baker"] }
  },
  "machines": {
    "order": {
      "ownedBy": "customer",
      "noun": "order",
      "start": "has an order",
      "initial": "Draft",
      "context": [
        { "name": "loaves", "type": "integer", "nullable": false, "constraints": [] },
        { "name": "approved", "type": "boolean", "nullable": true, "constraints": [] }
      ],
      "states": {
        "Draft": "is a draft",
        "Paying": "is being paid for",
        "Placed": "is placed",
        "Declined": "was declined",
        "Unpaid": "is unpaid",
        "Baking": "is baking",
        "Ready": "is ready to collect"
      },
      "triggers": {
        "Order": {
          "phrase": "orders {loaves} loaves for {subject}",
          "input": [ { "name": "loaves", "type": "integer", "nullable": false, "constraints": [] } ],
          "reduce": { "reduce": "set", "steps": [ { "field": "loaves", "value": { "input": "loaves" } } ] }
        },
        "Place": { "phrase": "places {subject}" },
        "Bake": { "phrase": "{subject} starts baking" }
      },
      "guards": {
        "hasLoaves": {
          "holds": "has something in it",
          "fails": "has nothing in it",
          "rule": { "rule": "compare", "source": "context", "field": "loaves", "op": "gt", "value": 0 }
        }
      },
      "invokes": {
        "Paying": {
          "train": "Trax.Samples.Bakery.Trains.ITakePaymentTrain",
          "input": { "loaves": "loaves" },
          "output": [ { "name": "approved", "type": "boolean", "nullable": false, "constraints": [] } ],
          "outcomes": {
            "the payment goes through": {
              "outcome": "done",
              "when": { "rule": "boolEquals", "source": "input", "field": "approved", "value": true }
            },
            "the payment is declined": {
              "outcome": "done",
              "when": { "rule": "boolEquals", "source": "input", "field": "approved", "value": false }
            },
            "the payment cannot be taken": { "outcome": "failed" },
            "the payment is called off": { "outcome": "cancelled" }
          },
          "examples": {
            "the payment goes through": { "approved": true },
            "the payment is declined": { "approved": false }
          }
        }
      }
    },
    "shift": {
      "ownedBy": "baker",
      "noun": "shift",
      "start": "has a shift",
      "initial": "Off",
      "states": { "Off": "is not started", "On": "is on", "Oven": "is at the oven", "Over": "is over" },
      "triggers": {
        "ClockIn": { "phrase": "clocks in for {subject}" },
        "FireOven": { "phrase": "fires the oven on {subject}" },
        "ClockOut": { "phrase": "clocks out of {subject}" }
      }
    },
    "shop": {
      "system": "shop/main",
      "name": "the shop",
      "initial": "Closed",
      "states": { "Closed": "is closed", "Open": "is open", "Firing": "is baking a batch" },
      "triggers": {
        "Open": { "phrase": "the shop opens" },
        "Close": { "phrase": "the shop closes" },
        "Batch": { "phrase": "the oven fires" }
      }
    }
  },
  "views": {
    "orders": {
      "reads": [ { "machine": "order" } ],
      "fields": {
        "status": {
          "from": "order.state",
          "labels": {
            "Draft": "Not sent",
            "Paying": "Paying",
            "Placed": "Waiting for the oven",
            "Declined": "Payment declined",
            "Unpaid": "Payment not taken",
            "Baking": "In the oven",
            "Ready": "Ready to collect"
          }
        },
        "loaves": { "from": "order.loaves" }
      }
    },
    "shop sign": {
      "reads": [ { "machine": "shop", "key": "shop/main" } ],
      "fields": { "open": { "from": "shop.state", "labels": { "Open": "We're open", "Firing": "We're open, the oven is on", "Closed": "Closed" } } }
    }
  }
}
