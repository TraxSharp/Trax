{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@traxsharp/state-machine": ["../../../../Trax.StateMachine/ts/src/index.ts"],
      "@traxsharp/state-machine/client": ["../../../../Trax.StateMachine/ts/src/client/index.ts"],
      "@traxsharp/state-machine/react": ["../../../../Trax.StateMachine/ts/src/react.ts"]
    }
  },
  "include": ["src"]
}
