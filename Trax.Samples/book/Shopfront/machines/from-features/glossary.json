{
  "version": 1,
  "actors": {
    "customer": {
      "noun": "a customer",
      "roles": [
        "Customer"
      ]
    }
  },
  "machines": {
    "order-return": {
      "ownedBy": "customer",
      "noun": "return",
      "start": "has a return",
      "initial": "Draft",
      "context": [
        {
          "name": "orderId",
          "type": "string",
          "nullable": false,
          "constraints": []
        },
        {
          "name": "reason",
          "type": "string",
          "nullable": false,
          "constraints": []
        }
      ],
      "states": {
        "Draft": "is a draft",
        "Checking": "is being checked",
        "Accepted": "is accepted",
        "Refused": "was refused",
        "Unchecked": "could not be checked"
      },
      "triggers": {
        "Describe": {
          "phrase": "fills in {subject} for order {orderId} because {reason}",
          "input": [
            {
              "name": "orderId",
              "type": "string",
              "nullable": false,
              "constraints": []
            },
            {
              "name": "reason",
              "type": "string",
              "nullable": false,
              "constraints": []
            }
          ],
          "reduce": {
            "reduce": "set",
            "steps": [
              {
                "field": "orderId",
                "value": {
                  "input": "orderId"
                }
              },
              {
                "field": "reason",
                "value": {
                  "input": "reason"
                }
              }
            ]
          }
        },
        "Send": {
          "phrase": "sends {subject}"
        }
      },
      "guards": {
        "hasReason": {
          "holds": "has a reason",
          "fails": "has no reason",
          "rule": {
            "rule": "nonEmpty",
            "source": "context",
            "field": "reason"
          }
        }
      },
      "invokes": {
        "Checking": {
          "train": "Shopfront.Trains.ReturnOrder.IReturnOrderTrain",
          "input": {
            "orderId": "orderId",
            "customerId": "$owner"
          },
          "output": [
            {
              "name": "accepted",
              "type": "boolean",
              "nullable": false,
              "constraints": []
            }
          ],
          "outcomes": {
            "the return is accepted": {
              "outcome": "done",
              "when": {
                "rule": "boolEquals",
                "source": "input",
                "field": "accepted",
                "value": true
              }
            },
            "the return is refused": {
              "outcome": "done",
              "when": {
                "rule": "boolEquals",
                "source": "input",
                "field": "accepted",
                "value": false
              }
            },
            "the return cannot be checked": {
              "outcome": "failed"
            },
            "the return is called off": {
              "outcome": "cancelled"
            }
          },
          "examples": {
            "the return is accepted": {
              "accepted": true
            },
            "the return is refused": {
              "accepted": false
            }
          }
        }
      }
    }
  },
  "views": {
    "returns": {
      "reads": [
        {
          "machine": "order-return"
        }
      ],
      "fields": {
        "status": {
          "from": "order-return.state",
          "labels": {
            "Draft": "Not sent",
            "Checking": "Being checked",
            "Accepted": "Accepted",
            "Refused": "Refused",
            "Unchecked": "Not checked yet"
          }
        },
        "reason": {
          "from": "order-return.reason"
        }
      }
    }
  }
}
