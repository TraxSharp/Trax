<Project>
  <!--
    Not part of the book. Shopfront is the project the Trax book builds, file for file, and a reader's
    copy has no Directory.Build.props: this one stops Trax.Samples/Directory.Build.props applying, so
    the projects build here as they do there. It adds only what every project in this repository
    does: a committed lockfile, restored in locked mode, and the Trax.Analyzers profile
    (Trax.Docs/adr/0061). Outside the repository the profile is not there and nothing is imported.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <_ShopfrontTraxAnalyzers>$(MSBuildThisFileDirectory)../../../Trax.Analyzers/Trax.Analyzers.InRepo.props</_ShopfrontTraxAnalyzers>
  </PropertyGroup>

  <Import Project="$(_ShopfrontTraxAnalyzers)" Condition="Exists('$(_ShopfrontTraxAnalyzers)')" />

  <!-- The profile references the banned-API analyzer, which the book's Directory.Packages.props
       does not pin; this is the root Directory.Packages.props pin, kept equal to it. -->
  <ItemGroup Condition="Exists('$(_ShopfrontTraxAnalyzers)')">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
