<Project>
  <!--
    Every third-party package version in the repository, for every folder. Project files carry
    no versions. Trax packages are never pinned here: inside the repository they are project
    references, built from the same commit.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Let a central PackageVersion apply to a package that also arrives
         transitively, so one version wins across the graph. It does NOT mean a
         PackageVersion can stand alone: one with no PackageReference anywhere is
         invisible to Dependabot and freezes. See the Tests.Meta pin guard. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- CPM rejects a floating PackageVersion unless this is set (Radzen.Blazor below). -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageVersion Include="Amazon.Lambda.SQSEvents" Version="3.0.1" />
    <PackageVersion Include="Amazon.Lambda.TestUtilities" Version="4.2.0" />
    <!-- bunit pulls AngleSharp transitively; pin it to clear GHSA-pgww-w46g-26qg (mXSS, all
         versions before 1.5.0). bunit 1.40.0 accepts the whole 1.x range. -->
    <PackageVersion Include="AngleSharp" Version="1.8.3" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AWSSDK.Lambda" Version="4.0.108.2" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.15" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="bunit" Version="1.40.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- Property-based tests (Trax.Docs/adr/0044). Test projects only, never a shipped package. -->
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="dbup-core" Version="6.1.1" />
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
    <PackageVersion Include="dbup-sqlite" Version="6.0.4" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="GraphQL" Version="8.8.5" />
    <PackageVersion Include="GraphQL-Parser" Version="9.5.1" />
    <PackageVersion Include="GraphQL.Client" Version="6.1.0" />
    <PackageVersion Include="GraphQL.Client.Serializer.SystemTextJson" Version="6.1.0" />
    <PackageVersion Include="HotChocolate" Version="16.6.7" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.7" />
    <PackageVersion Include="HotChocolate.AspNetCore.Authorization" Version="16.6.7" />
    <PackageVersion Include="HotChocolate.CostAnalysis" Version="16.6.7" />
    <PackageVersion Include="HotChocolate.Data" Version="16.6.7" />
    <PackageVersion Include="HotChocolate.Data.EntityFramework" Version="16.6.7" />
    <PackageVersion Include="HotChocolate.Execution.Projections" Version="16.6.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0-1.26328.17" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.OpenApi.Readers" Version="1.6.31" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <!-- Floats within its major on purpose (Trax.Dashboard/docs/adr/0006). It moves only when
         the lockfiles are regenerated: CI restores in locked mode, so packages.lock.json holds
         the version every build uses, and the packed nuspec carries it as its minimum. -->
    <PackageVersion Include="Radzen.Blazor" Version="11.*" />
    <PackageVersion Include="Scriban" Version="7.5.0" />
    <!-- Referenced directly by the SQLite-using projects rather than pinned transitively: a
         PackageVersion with no PackageReference is invisible to Dependabot and freezes, which
         for a CVE floor means it silently stops working. Overrides the vulnerable native lib
         EF Core Sqlite pulls transitively (CVE-2025-6965). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
  </ItemGroup>
</Project>
