<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <Import
    Project="$(MSBuildThisFileDirectory)trax-local.props"
    Condition="Exists('$(MSBuildThisFileDirectory)trax-local.props')"
  />
  <ItemGroup>
    <PackageVersion Include="Trax.Core.Testing" Version="1.7.0" />
    <PackageVersion Include="Trax.Effect" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Data" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Data.InMemory" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Data.Postgres" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.JunctionProvider.Logging" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Provider.Json" Version="1.54.0" />
    <PackageVersion Include="Trax.Effect.Provider.Parameter" Version="1.54.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
  </ItemGroup>

  <!--
    Local development override. pack-local.sh writes a gitignored trax-local.props
    setting TraxLocalVersion=1.99.99; this redirects every Trax.* pin above to the
    locally packed build. The pins themselves stay plain literal versions so they
    stay machine-readable: an MSBuild expression in the Version attribute is not a
    version Dependabot can parse, and it silently skipped every one of them.
  -->
  <ItemGroup Condition="'$(TraxLocalVersion)' != ''">
    <PackageVersion Update="Trax.Core.Testing" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.InMemory" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.Postgres" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.JunctionProvider.Logging" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Provider.Json" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Provider.Parameter" Version="$(TraxLocalVersion)" />
  </ItemGroup>
</Project>
