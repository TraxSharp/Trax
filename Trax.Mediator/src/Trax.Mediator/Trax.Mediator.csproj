<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Trax.Mediator</AssemblyName>
    <PackageDescription>Decoupled dispatch for Trax .NET trains: ITrainBus runs the train registered for an input's type, so callers never reference a concrete train. Adds assembly scanning, the train registry, [TraxAuthorize] train authorization and concurrency limits. Install it when callers should hand over an input rather than inject a specific train.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Mediator.Tests.MemoryLeak.Integration" />
    <InternalsVisibleTo Include="Trax.Mediator.Tests.Postgres.Integration" />
  </ItemGroup>

  <!-- A run's links to another run (the decisions it replays, the run it resumes) are set only by the operations
       service, which checks the run it names first, so QueueTrainOptions sets them internally. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Scheduler" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../../Trax.Effect/src/Trax.Effect/Trax.Effect.csproj" />
    <ProjectReference Include="../../../Trax.Effect/src/Trax.Effect.Data/Trax.Effect.Data.csproj" />
    <!-- The state machine declares the port that queues a state's invoked train (IInvokedTrainLauncher); the
         mediator implements it, so the enqueue goes through train authorization like any caller's. -->
    <ProjectReference Include="../../../Trax.Effect/src/Trax.Effect.StateMachine.Persistence/Trax.Effect.StateMachine.Persistence.csproj" />
  </ItemGroup>
</Project>
