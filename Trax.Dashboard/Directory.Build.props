<Project>
  <PropertyGroup>
    <Version>1.99.99</Version>
    <!-- Audit direct + transitive dependencies and fail the build on any known
         vulnerability (low through critical). -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Package validation: `dotnet pack` compares the published library with the last release on
       nuget.org and fails on a binary break, such as removing or narrowing a public member a host
       compiled against. It runs on pack only, so the pull request workflow packs too. Bump the
       baseline to the new version after each release. The Version above (1.99.99 locally, the
       released version in CI) is the package being checked, not the baseline. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Trax.Dashboard'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.15.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Package metadata shared by every package this repo publishes. A project can
       override any of it. -->
  <PropertyGroup>
    <Authors>Theauxm</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TraxSharp/Trax.Dashboard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://traxsharp.net/docs</PackageProjectUrl>
    <PackageTags>trax;dotnet;dashboard;blazor;blazor-server;radzen;monitoring;scheduler</PackageTags>
    <!-- No .snupkg: DotNet.ReproducibleBuilds sets DebugType=embedded, so the PDB, with
         SourceLink, ships inside the DLL. -->
  </PropertyGroup>

  <!-- Shipping libraries: everything under src/. Tests are not packed and do not need XML docs. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment on a public member) is the one doc warning suppressed.
         The summaries that exist ship in the package now; the undocumented public members,
         including those the Razor compiler generates for every component, are a tracked
         burn-down. Every other doc-comment warning (malformed XML, bad cref, param mismatch)
         stays on and fails the zero-warning build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="\"
      Visible="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All" />
  </ItemGroup>
</Project>
