<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Let a central PackageVersion apply to a package that also arrives
         transitively, so one version wins across the graph. It does NOT mean a
         PackageVersion can stand alone: one with no PackageReference anywhere is
         invisible to Dependabot and freezes. See the Tests.Meta pin guard. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Radzen.Blazor (11.*) and Microsoft.Extensions.DependencyInjection (10.*) float
         within their major on purpose (docs/adr/0006). CPM rejects a floating PackageVersion
         unless this is set, and once set it accepts one on any package. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <!-- Local development override: sets TraxLocalVersion to 1.99.99 so locally-packed
       Trax.* packages win over the CI-pinned versions below. Not committed. -->
  <Import Project="trax-local.props" Condition="Exists('trax-local.props')" />

  <!-- Trax.* cross-repo packages. CI pins the exact resolved version; a local build
       can override via TraxLocalVersion (set by trax-local.props). -->
  <ItemGroup>
    <PackageVersion Include="Trax.Api.GraphQL.PersistedOperations" Version="1.46.0" />
    <PackageVersion Include="Trax.Core.Testing" Version="1.9.1" />
    <PackageVersion Include="Trax.Effect" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.Data" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.Data.InMemory" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.Data.Postgres" Version="1.59.0" />
    <PackageVersion Include="Trax.Effect.Provider.Parameter" Version="1.59.0" />
    <PackageVersion Include="Trax.Mediator" Version="1.24.1" />
    <PackageVersion Include="Trax.Scheduler" Version="1.36.0" />
  </ItemGroup>

  <!-- Third-party packages. Exact versions, except the two floats above (docs/adr/0006).
       A float moves only when the lockfiles are regenerated: CI restores with locked mode,
       so packages.lock.json holds the version every build uses, and the packed nuspec
       carries that resolved version as its minimum. -->
  <ItemGroup>
    <!-- bunit pulls AngleSharp transitively; pin it to 1.5.0 to clear GHSA-pgww-w46g-26qg (mXSS,
         all versions before 1.5.0). bunit 1.40.0 accepts the whole 1.x range. -->
    <PackageVersion Include="AngleSharp" Version="1.8.3" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="bunit" Version="1.40.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.4.5" />
    <PackageVersion Include="Radzen.Blazor" Version="11.*" />
  </ItemGroup>

  <!--
    Local development override. pack-local.sh writes a gitignored trax-local.props
    setting TraxLocalVersion=1.99.99; this redirects every Trax.* pin above to the
    locally packed build. The pins themselves stay plain literal versions so they
    stay machine-readable: an MSBuild expression in the Version attribute is not a
    version Dependabot can parse, and it silently skipped every one of them.
  -->
  <ItemGroup Condition="'$(TraxLocalVersion)' != ''">
    <PackageVersion Update="Trax.Api.GraphQL.PersistedOperations" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Core.Testing" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.InMemory" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Data.Postgres" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Effect.Provider.Parameter" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Mediator" Version="$(TraxLocalVersion)" />
    <PackageVersion Update="Trax.Scheduler" Version="$(TraxLocalVersion)" />
  </ItemGroup>
</Project>
