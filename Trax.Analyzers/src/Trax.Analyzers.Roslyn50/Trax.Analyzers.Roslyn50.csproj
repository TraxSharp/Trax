<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same rules as ../Trax.Analyzers, built against Roslyn 5.0 for the first .NET 10 SDKs
       (Analyzer.props). It compiles that folder's sources; it has none of its own. -->
  <PropertyGroup>
    <RoslynVersion>5.0</RoslynVersion>
    <AssemblyName>Trax.Analyzers</AssemblyName>
    <RootNamespace>Trax.Analyzers</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="../Analyzer.props" />

  <ItemGroup>
    <Compile
      Include="../Trax.Analyzers/**/*.cs"
      Exclude="../Trax.Analyzers/bin/**;../Trax.Analyzers/obj/**"
    />
    <EmbeddedResource
      Include="../Trax.Analyzers/Resources/*.txt"
      LogicalName="Trax.Analyzers.Resources.%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>
