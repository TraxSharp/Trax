<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rules, built against Roslyn 5.6 (Analyzer.props explains the two builds). The sources
       are copied from Meziantou.Analyzer by tools/sync-upstream.sh; this file is Trax's own. -->
