<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Every package comes from nuget.org. The clears stop a nuget.config above this checkout
       (for example a local feed in a parent folder) from adding sources or mappings, so a
       restore here resolves the same packages on a laptop as in CI. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
