<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Trax.Effect.StateMachine.Testing</AssemblyName>
    <Description>Cross-runtime differential conformance for Trax .NET state machines: replay a generated differential corpus through the C# engine and get back the cases it fails to reproduce. The corpus is produced by the TypeScript oracle (@trax/state-machine); this proves the two engine ports stay behaviorally identical. Framework-agnostic — returns a diff list you assert on.</Description>
    <PackageTags>trax;testing;statemachine;conformance;differential</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Effect.StateMachine/Trax.Effect.StateMachine.csproj" />
    <ProjectReference Include="../Trax.Effect.StateMachine.Persistence/Trax.Effect.StateMachine.Persistence.csproj" />
  </ItemGroup>
</Project>
