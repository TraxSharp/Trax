<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Typed decision model adapter for Trax.Effect. Adds AddNimbleDecider(...), for Bespoke Labs' open-weights Nimble on a Nimble server you run, and AddSystemOneDecider(...) to the AddEffects builder, which answer a train's Decide, Switch, Gate and Scale questions through the System One request format that Jev and Nimble's server accept, with retries, a pinned model version, named registrations for running several models side by side, and every answer checked before a train acts on it.</Description>
    <AssemblyName>Trax.Effect.Decisions.SystemOne</AssemblyName>
    <!-- Not yet released, so there is no baseline to validate against. Remove after its first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Effect/Trax.Effect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.Tests.Integration" />
  </ItemGroup>
</Project>
