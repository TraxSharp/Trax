<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Parameter effect provider for Trax.Effect. Adds SaveTrainParameters() to the AddEffects builder, which serializes each train's input and output into its Metadata row, masking members marked [TraxSensitive].</Description>
    <AssemblyName>Trax.Effect.Provider.Parameter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Effect/Trax.Effect.csproj" />
  </ItemGroup>
</Project>
