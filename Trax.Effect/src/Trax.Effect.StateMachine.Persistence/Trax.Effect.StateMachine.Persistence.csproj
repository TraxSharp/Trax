<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Persistence for the Trax .NET snapshot state-machine engine: a user-scoped snapshot store with optimistic concurrency, the FE-drives/BE-validates draft service, and a generic exactly-once effect primitive (lease + fence token).</Description>
    <AssemblyName>Trax.Effect.StateMachine.Persistence</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Effect.StateMachine/Trax.Effect.StateMachine.csproj" />
    <!-- The generic mutation surface (ServiceTrain / Junction / [TraxMutation]) and AddStateMachines. -->
    <ProjectReference Include="../Trax.Effect/Trax.Effect.csproj" />
    <!-- IDataContext, whose SnapshotDrafts and EffectClaims the stores reach their tables through, and ISqlDialect. -->
    <ProjectReference Include="../Trax.Effect.Data/Trax.Effect.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <!-- The invoked-run ports: the mediator implements the launcher, and the operations service applies an
         operator's cancel through the outcome delivery. A host neither implements nor calls them. -->
    <InternalsVisibleTo Include="Trax.Mediator" />
    <InternalsVisibleTo Include="Trax.Scheduler" />
    <InternalsVisibleTo Include="Trax.Effect.StateMachine.Persistence.Integration" />
    <InternalsVisibleTo Include="Trax.Effect.StateMachine.Tests.Stress" />
    <InternalsVisibleTo Include="Trax.Effect.StateMachine.Tests" />
    <!-- The mediator implements the launcher; its tests run the startup check per machine and read the
         owner-aware store, which this folder's tests cannot reach without the mediator. -->
    <InternalsVisibleTo Include="Trax.Mediator.Tests.StateMachine.Integration" />
    <!-- The outcome delivery tests drive the reconciler's sweep against a real dispatcher, job runner and reaper,
         which only the scheduler's tests reach. -->
    <InternalsVisibleTo Include="Trax.Scheduler.Tests.Integration" />
  </ItemGroup>
</Project>
