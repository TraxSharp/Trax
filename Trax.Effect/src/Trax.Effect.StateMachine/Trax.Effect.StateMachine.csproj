<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Portable, resumable snapshot state-machine engine. Pure, dependency-free: represents a multi-step flow's state as language-neutral JSON so a C# backend and a TypeScript client agree on it, with illegal (state, context) pairs unrepresentable and every operation total.</Description>
    <AssemblyName>Trax.Effect.StateMachine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.StateMachine.Tests" />
    <!-- Reads the exception behind an internal-error rejection, to log it without returning its text. -->
    <InternalsVisibleTo Include="Trax.Effect.StateMachine.Persistence" />
  </ItemGroup>
</Project>
