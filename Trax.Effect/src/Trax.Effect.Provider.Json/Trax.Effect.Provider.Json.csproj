<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>JSON effect provider for Trax.Effect. Adds AddJson() to the AddEffects builder, which logs each tracked model's state as JSON as a train runs. For debugging.</Description>
    <AssemblyName>Trax.Effect.Provider.Json</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Effect/Trax.Effect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.Tests.Integration" />
    <InternalsVisibleTo Include="Trax.Effect.Tests.Json.Integration" />
  </ItemGroup>
</Project>
