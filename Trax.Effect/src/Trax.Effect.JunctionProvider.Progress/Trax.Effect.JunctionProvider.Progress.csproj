<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Junction progress and cancellation provider for Trax.Effect. Adds AddJunctionProgress() to the AddEffects builder, which persists the current junction (index, total, name) on the Metadata row and checks for cancellation before each junction runs. Needs a data provider.</Description>
    <AssemblyName>Trax.Effect.JunctionProvider.Progress</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Effect/Trax.Effect.csproj" />
    <ProjectReference Include="../Trax.Effect.Data/Trax.Effect.Data.csproj" />
  </ItemGroup>
</Project>
