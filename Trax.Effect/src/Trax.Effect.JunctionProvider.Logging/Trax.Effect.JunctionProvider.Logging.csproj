<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Junction logging provider for Trax.Effect. Adds AddJunctionLogger(serializeJunctionData) to the AddEffects builder, which logs each junction's start, finish and duration, optionally with its serialized input and output.</Description>
    <AssemblyName>Trax.Effect.JunctionProvider.Logging</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Effect/Trax.Effect.csproj" />
  </ItemGroup>
</Project>
