<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>The effect layer for Trax .NET trains: the ServiceTrain base class that records every run as a Metadata row (state, timing, input, output, failure), DI registration (AddTrax, AddEffects, AddScopedTraxRoute), lifecycle hooks and the UseBroadcaster event pipeline. Install it with one data provider (Trax.Effect.Data.Postgres, .Sqlite or .InMemory) to persist those runs.</Description>
    <AssemblyName>Trax.Effect</AssemblyName>
    <!-- TRAXEXP001: a run records the failure of a Parallel step (BranchesFailedException) by
         classifying each failed branch, so the effect layer reads the experimental step's types. -->
    <NoWarn>$(NoWarn);TRAXEXP001</NoWarn>
    <!-- TRAXEXP002: the work queue entry and the run record which state-machine instance invoked them, and
         the models write those experimental columns themselves. -->
    <NoWarn>$(NoWarn);TRAXEXP002</NoWarn>
    <!-- TRAXEXP003: a run stores the checkpoints it reaches and resumes from them, so the effect layer is
         where the experimental feature's runtime lives. -->
    <NoWarn>$(NoWarn);TRAXEXP003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Trax.Core/src/Trax.Core/Trax.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.Tests.Integration" />
    <InternalsVisibleTo Include="Trax.Effect.Tests.Broadcaster" />
    <InternalsVisibleTo Include="Trax.Effect.Tests.Data.InMemory.Integration" />
    <InternalsVisibleTo Include="Trax.Effect.StateMachine.Persistence.Integration" />
  </ItemGroup>

  <!--
    The builder flags that build-time validation reads (TraxBuilder.HasDatabaseProvider, HasDataProvider,
    MediatorConfigured) have internal setters, so a consumer cannot pass that validation without the provider or
    the mediator it checks for. These are the assemblies that earn a flag and set it.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.Data.Postgres" />
    <InternalsVisibleTo Include="Trax.Effect.Data.Sqlite" />
    <InternalsVisibleTo Include="Trax.Effect.Data.InMemory" />
    <InternalsVisibleTo Include="Trax.Mediator" />
  </ItemGroup>

  <!-- The cancel-flag check marks its factory as one (ICancellationFlagCheckFactory), so the state-machine startup
       check can require it for a machine that invokes trains, and reads whether an output reaches a sensitive
       member (TraxRedaction). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.JunctionProvider.Progress" />
    <InternalsVisibleTo Include="Trax.Effect.StateMachine.Persistence" />
  </ItemGroup>

  <!-- The engine serializes an invoked run's output with the options a run stores it with (InvokedRunOutput), so the
       two cannot drift. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.StateMachine" />
  </ItemGroup>

  <!-- Decision recording binds each run's decisions to its row through ServiceTrain.Run. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.Data" />
  </ItemGroup>
</Project>
