<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>The shared data layer behind the Trax.Effect data providers: the IDataContext over the Trax .NET tables (metadata, logs, manifests, work queue), AddDataContextLogging, and the DomainDataContext base with AddDomainDataContext for your own schemas. You normally get it through Trax.Effect.Data.Postgres, .Sqlite or .InMemory rather than installing it directly.</Description>
    <AssemblyName>Trax.Effect.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Trax.Effect/Trax.Effect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <!-- The junction run writer's flush is for tests that read the rows it writes. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.Tests.Integration" />
    <InternalsVisibleTo Include="Trax.Effect.Tests.Data.InMemory.Integration" />
    <InternalsVisibleTo Include="Trax.Effect.Tests.Data.Sqlite.Integration" />
  </ItemGroup>
  <!-- Each provider registers the checkpoint rows, which every provider shares. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Trax.Effect.Data.Postgres" />
    <InternalsVisibleTo Include="Trax.Effect.Data.Sqlite" />
    <InternalsVisibleTo Include="Trax.Effect.Data.InMemory" />
  </ItemGroup>
</Project>
