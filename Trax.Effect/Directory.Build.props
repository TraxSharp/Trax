<Project>
  <PropertyGroup>
    <Version>1.99.99</Version>
    <!-- Audit direct + transitive dependencies and fail the build on any known
         vulnerability (low through critical). -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet metadata shared by every package this repo publishes. A project sets only its own
       Description, and PackageTags where it wants more specific ones. -->
  <PropertyGroup>
    <Authors>Theauxm,mark-keaton</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TraxSharp/Trax.Effect</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://traxsharp.net/docs</PackageProjectUrl>
    <PackageTags>trax;dotnet;effects;trains;junctions;railway-oriented-programming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- No .snupkg: DotNet.ReproducibleBuilds embeds the PDB, with SourceLink, in each DLL. -->
  </PropertyGroup>

  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="\"
      Visible="false"
    />
  </ItemGroup>

  <!-- Package validation: `dotnet pack` compares each published library with the last release on
       nuget.org and fails on a binary break, such as narrowing a member a published downstream
       package calls or overrides. It runs on pack only, so the pull request workflow packs too.
       Every project under src/ ships as a package, so a new one is validated without being listed
       here. Until its first release there is no baseline to compare with, so set
       EnablePackageValidation to false in its csproj and remove that once it has shipped. Bump the
       baseline to the new version after each release. The Version above (1.99.99 locally, the released
       version in CI) is the package being checked, not the baseline. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/'))">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.56.0</PackageValidationBaselineVersion>
    <!-- Ship the XML doc file so the /// summaries reach consumers' IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- CS1591 (a public member with no doc comment) is the one doc warning suppressed: the summaries
       that exist ship now, and the undocumented members are a tracked burn-down. Every other
       doc-comment warning (malformed XML, a bad cref, a param mismatch) stays on and fails the build.
       Trax.Effect.Data.Testing and Trax.Effect.StateMachine.Testing already document every public
       member, so they keep CS1591 on. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/')) And '$(MSBuildProjectName)' != 'Trax.Effect.Data.Testing' And '$(MSBuildProjectName)' != 'Trax.Effect.StateMachine.Testing'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All" />
  </ItemGroup>
</Project>
